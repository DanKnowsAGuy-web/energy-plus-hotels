---
// Self-hosted fonts (no external network, faster, renders anywhere).
import "@fontsource-variable/newsreader/wght.css";
import "@fontsource-variable/newsreader/wght-italic.css";
import "@fontsource-variable/inter/wght.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/oswald/600.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Energy Plus: verified energy savings for hotels",
  description = "We cut your hotel's energy costs and prove the savings at your meter before you pay a cent. We even pay for the diagnosis ourselves.",
} = Astro.props;

// Vertical through-line waveform paths (built once at compile time).
// The distorted line is deliberately jagged: harmonic content plus a
// deterministic point-to-point hash jitter so it reads as violent noise.
const TLH = 1000;
const TLN = 480;
const tlMid = 15;
const tlAmp = 9;
function tlHash(i: number) {
  const s = Math.sin(i * 127.1 + 311.7) * 43758.5453;
  return (s - Math.floor(s)) * 2 - 1;
}
function tlPath(distort: boolean) {
  let d = "";
  for (let i = 0; i <= TLN; i++) {
    const y = (i / TLN) * TLH;
    const t = (i / TLN) * Math.PI * 2 * 26;
    const x = distort
      ? tlMid +
        tlAmp *
          (0.5 * Math.sin(t) +
            0.26 * Math.sin(3 * t + 0.6) +
            0.2 * Math.sin(7 * t + 1.2) +
            0.38 * tlHash(i))
      : tlMid + tlAmp * Math.sin(t);
    d += (i === 0 ? "M" : "L") + x.toFixed(1) + " " + y.toFixed(1) + " ";
  }
  return d.trim();
}
const tlDist = tlPath(true);
const tlClean = tlPath(false);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#081710" />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"></div>

    <div class="through-line" aria-hidden="true">
      <svg viewBox="0 0 30 1000" preserveAspectRatio="none" fill="none">
        <g class="through-line__dist">
          <path
            id="tl-dist-path"
            d={tlDist}
            stroke="#e05a2b"
            stroke-width="1.4"
            vector-effect="non-scaling-stroke"></path>
          <circle class="through-line__spark" data-spark-dur="7" data-spark-off="0" r="2.4" fill="#ff8a4d"></circle>
          <circle class="through-line__spark through-line__spark--b" data-spark-dur="11" data-spark-off="0.45" r="1.8" fill="#ffb070"></circle>
        </g>
        <path
          class="through-line__clean"
          d={tlClean}
          stroke="var(--gold-text)"
          stroke-width="1.4"
          vector-effect="non-scaling-stroke"></path>
      </svg>
    </div>

    <div class="grain" aria-hidden="true"></div>
    <slot />

    <script>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

      // Reveal-on-scroll: content is visible by default (see .reveal in CSS);
      // this only adds the entrance for users who allow motion. Lists carry
      // style="--i: n" so siblings cascade in rather than all firing at once.
      if (!reduce.matches && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
        );
        document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      }

      // Scroll-progress rail + through-line cleanup (rAF-throttled, one pass).
      const rail = document.querySelector(".scroll-progress");
      const thru = document.querySelector(".through-line");
      if ((rail || thru) && !reduce.matches) {
        let ticking = false;
        const update = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          const p = max > 0 ? h.scrollTop / max : 0;
          if (rail) rail.style.transform = "scaleX(" + p.toFixed(4) + ")";
          // through-line resolves a touch ahead of the rail so it reads "clean"
          // by the time you reach the money sections.
          if (thru) thru.style.setProperty("--tl", Math.min(p * 1.15, 1).toFixed(4));
          ticking = false;
        };
        addEventListener(
          "scroll",
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true },
        );
        update();
      }

      // Traveling sparks on the through-line's distorted wave (rAF-driven;
      // SMIL is unreliable across engines). They inherit the group's opacity,
      // so they fade out as the line resolves clean.
      try {
        const tlWrap = document.querySelector(".through-line");
        const sparkPath = document.getElementById("tl-dist-path");
        const sparks = document.querySelectorAll(".through-line__spark");
        const tlVisible =
          tlWrap && getComputedStyle(tlWrap).display !== "none";
        if (tlVisible && sparkPath && sparks.length && !reduce.matches) {
          const len = sparkPath.getTotalLength();
          if (len > 0) {
            const items = Array.from(sparks).map((el) => ({
              el,
              dur: Number(el.getAttribute("data-spark-dur")) * 1000,
              off: Number(el.getAttribute("data-spark-off")),
            }));
            const t0 = performance.now();
            const step = (now) => {
              for (const s of items) {
                const t = (((now - t0) / s.dur) + s.off) % 1;
                const pt = sparkPath.getPointAtLength(t * len);
                s.el.setAttribute("cx", pt.x.toFixed(2));
                s.el.setAttribute("cy", pt.y.toFixed(2));
              }
              requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }
        }
      } catch (e) {
        /* sparks are decoration; never let them break the page scripts */
      }

      // Mint pulse: the "diagnosis is on us" dot pulses once on arrival.
      const dot = document.querySelector(".pay__dot");
      if (dot && !reduce.matches && "IntersectionObserver" in window) {
        const io3 = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-pulse");
                io3.disconnect();
              }
            }
          },
          { threshold: 0.9 },
        );
        io3.observe(dot);
      }

      // Count-up on the load-waste stat. Enhances the visible default; if motion
      // is reduced or IO is unavailable, the static "~30%" simply stays put.
      const stat = document.querySelector("[data-countup]");
      if (stat && !reduce.matches && "IntersectionObserver" in window) {
        const target = Number(stat.getAttribute("data-countup")) || 0;
        const prefix = stat.textContent.trim().startsWith("~") ? "~" : "";
        const io2 = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              io2.unobserve(entry.target);
              const start = performance.now();
              const dur = 900;
              const ease = (t) => 1 - Math.pow(1 - t, 4);
              const tick = (now) => {
                const t = Math.min((now - start) / dur, 1);
                stat.textContent = prefix + Math.round(ease(t) * target) + "%";
                if (t < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
            }
          },
          { threshold: 0.6 },
        );
        io2.observe(stat);
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: var(--z-header);
        background: var(--gold);
        color: #0a1422;
        padding: 0.6rem 1rem;
        border-radius: var(--radius-s);
        font-weight: 600;
        text-decoration: none;
        transition: top 0.2s ease;
      }
      .skip-link:focus {
        top: 1rem;
      }
    </style>
  </body>
</html>
