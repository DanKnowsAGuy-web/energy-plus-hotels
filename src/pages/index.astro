---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ActOne from "../components/ActOne.astro";
import ActTwo from "../components/ActTwo.astro";
import ActFour from "../components/ActFour.astro";
import Harmonizer from "../components/Harmonizer.astro";
import Proof from "../components/Proof.astro";
import HowYouPay from "../components/HowYouPay.astro";
import Floor from "../components/Floor.astro";
import Calculator from "../components/Calculator.astro";
import Numbers from "../components/Numbers.astro";
import Plan from "../components/Plan.astro";
import WhoWeWork from "../components/WhoWeWork.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <ActOne />
    <ActTwo />
    <ActFour />
    <Harmonizer />
    <Proof />
    <HowYouPay />
    <Floor />
    <Calculator />
    <Numbers />
    <Plan />
    <WhoWeWork />
    <FinalCta />
  </main>
  <Footer />
</Base>
