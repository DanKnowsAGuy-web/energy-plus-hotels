---
// BRUTAL-EDIT: the old standalone Floor section compressed to a three-figure
// strip that sits directly above the Estimator, so "the number" is stated once,
// next to where the operator models their own.
const figures = [
  { value: "20%", unit: "off your total energy bill", note: "the conservative floor, full program" },
  { value: "Your meter", unit: "whole building, service entrance", note: "measured, not modeled" },
  { value: "$0", unit: "to find out", note: "we fund the diagnosis" },
];
---

<section class="section floorstrip" id="floor" aria-labelledby="floorstrip-title">
  <div class="container">
    <h2 class="floorstrip__title" id="floorstrip-title">See your building's floor.</h2>
    <ul class="floorstrip__list">
      {figures.map((f, i) => (
        <li class="floorstrip__item reveal" style={`--i: ${i}`}>
          <span class="floorstrip__value">{f.value}</span>
          <span class="floorstrip__unit">{f.unit}</span>
          <span class="floorstrip__note">{f.note}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .floorstrip {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .floorstrip__title { font-size: var(--step-2); max-width: 18ch; }
  .floorstrip__list {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-m);
  }
  .floorstrip__item {
    padding: var(--space-m);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .floorstrip__value {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1;
    color: var(--gold-text);
    letter-spacing: -0.02em;
  }
  .floorstrip__unit { font-size: var(--step-0); color: var(--ink); }
  .floorstrip__note {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
</style>
