---
const items = [
  {
    term: "Elevator traction motors",
    body: "Hard starts at six to eight times running current are the primary cause of early motor failure. Emergency modernization runs $50K to $150K per cab, with four to eight week parts lead times and ADA exposure while the cab is down.",
    tag: "$50K–$150K per cab",
  },
  {
    term: "Per-room PTAC fleet",
    body: "Your per-room HVAC units run around the clock whether guests are in the room or not, carrying more electrical stress than almost any load in the building. Replacing the fleet across a 150-room property runs $260K to $480K, and dirty power gets you there years too early.",
    tag: "$260K–$480K per property",
  },
  {
    term: "Aquatic, spa, and laundry drives",
    body: "Pool and spa pump replacement runs $8K to $25K per pump, and a closure in peak season turns directly into guest dissatisfaction and review damage. Commercial laundry drives fail the same way: properties typically run four to eight machines continuously.",
    tag: "$8K–$25K per pump",
  },
];
---

<section class="section actfour" id="what-we-find" aria-labelledby="actfour-title">
  <div class="container">
    <div class="actfour__head reveal">
      <h2 class="actfour__title" id="actfour-title">
        What dirty power costs a hotel.
      </h2>
      <p class="actfour__lede lede">
        We work on hotels, so we know exactly which loads carry the stress.
        Single-box vendors never look at most of this. We measure all of it,
        at the panel, before and after.
      </p>
    </div>

    <ol class="actfour__list">
      {
        items.map((it, i) => (
          <li class="threat reveal" style={`--i: ${i}`}>
            <span class="threat__ico" aria-hidden="true">
              {i === 0 && (
                <svg viewBox="0 0 40 40" fill="none">
                  <rect class="ti-body" x="4" y="4" width="32" height="32" rx="3" />
                  <line class="ti-ln" x1="20" y1="4" x2="20" y2="36" />
                  <path class="ti-ln" d="M9 21 l5 -6 5 6" />
                  <path class="ti-ln" d="M25 19 l5 6 5 -6" transform="translate(-4,0)" />
                </svg>
              )}
              {i === 1 && (
                <svg viewBox="0 0 40 40" fill="none">
                  <rect class="ti-body" x="4" y="6" width="32" height="28" rx="3" />
                  <line class="ti-ln" x1="9" y1="14" x2="31" y2="14" />
                  <line class="ti-ln" x1="9" y1="20" x2="31" y2="20" />
                  <circle class="ti-ln" cx="20" cy="27" r="4" />
                </svg>
              )}
              {i === 2 && (
                <svg viewBox="0 0 40 40" fill="none">
                  <rect class="ti-body" x="4" y="6" width="32" height="28" rx="3" />
                  <circle class="ti-ln" cx="17" cy="21" r="7" />
                  <path class="ti-ln" d="M17 21 l5 -4" />
                  <line class="ti-ln" x1="24" y1="14" x2="32" y2="14" />
                </svg>
              )}
            </span>
            <div class="threat__main">
              <h3 class="threat__term">{it.term}</h3>
              <p class="threat__body">{it.body}</p>
            </div>
            <span class="threat__tag">{it.tag}</span>
          </li>
        ))
      }
    </ol>

    <p class="actfour__close reveal">
      None of this appears on your bill as a line item called waste, and none
      of it shows up in a standard energy audit. That is exactly why it
      survives for years.
    </p>
  </div>
</section>

<style>
  .actfour {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(
        ellipse 50% 45% at 8% 100%,
        rgba(199, 168, 107, 0.04),
        transparent 70%
      ),
      var(--bg);
  }
  .actfour__head {
    max-width: 54rem;
  }
  .actfour__title {
    margin-top: var(--space-xs);
    font-size: var(--step-3);
    max-width: 20ch;
  }
  .actfour__lede {
    margin-top: var(--space-m);
  }

  .actfour__list {
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .threat {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: var(--space-m) var(--space-l);
    padding: clamp(1.4rem, 3vw, 2rem) 0;
    border-bottom: 1px solid var(--line-strong);
  }

  /* distressed equipment icon: same geometry as the harmonizer loads, shown
     hot here so the scene below reads as these exact machines being healed */
  .threat__ico {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-s);
    background: rgba(224, 90, 43, 0.08);
    border: 1px solid rgba(224, 90, 43, 0.35);
  }
  .threat__ico svg {
    width: 34px;
    height: 34px;
    filter: drop-shadow(0 0 5px rgba(224, 90, 43, 0.45));
  }
  .threat__ico .ti-body {
    fill: rgba(224, 90, 43, 0.12);
    stroke: #e05a2b;
    stroke-width: 1.6;
  }
  .threat__ico .ti-ln {
    stroke: #e05a2b;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  @media (prefers-reduced-motion: no-preference) {
    .threat__ico svg {
      animation: threatShake 0.34s ease-in-out infinite;
    }
    .threat:nth-child(2) .threat__ico svg {
      animation-delay: 0.09s;
    }
    .threat:nth-child(3) .threat__ico svg {
      animation-delay: 0.18s;
    }
    @keyframes threatShake {
      0%, 100% { transform: translate(0, 0); }
      25% { transform: translate(0.8px, -0.5px); }
      75% { transform: translate(-0.8px, 0.5px); }
    }
  }
  .threat__term {
    font-size: var(--step-2);
    color: var(--ink);
    margin-bottom: var(--space-xs);
  }
  .threat__body {
    color: var(--body);
    font-size: var(--step-0);
    line-height: 1.6;
    max-width: 58ch;
  }
  .threat__tag {
    align-self: center;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--gold-text);
    white-space: nowrap;
    padding: 0.4em 0.8em;
    border: 1px solid var(--gold-soft);
    border-radius: 999px;
  }

  .actfour__proof {
    margin-top: var(--space-2xl);
  }
  .actfour__proof-label {
    font-size: var(--step-0);
    color: var(--body);
    max-width: 52ch;
  }

  .actfour__close {
    margin-top: var(--space-2xl);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink);
    max-width: 50ch;
  }

  @media (max-width: 680px) {
    .threat {
      grid-template-columns: auto 1fr;
    }
    .threat__tag {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
