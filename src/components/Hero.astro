---
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__photo" aria-hidden="true"></div>
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__spot" aria-hidden="true"></div>

  <div class="container hero__inner">
    <p class="hero__kicker reveal">For hotel owners and portfolio operators</p>

    <h1 class="hero__title reveal" id="hero-title">
      We cut your hotel's energy costs and
      <span class="hero__title-accent">prove the savings before you pay a cent.</span>
    </h1>

    <p class="hero__lede lede reveal">
      We diagnose your whole building at our own expense, verify the savings at
      your meter, and you commit nothing until the number is real.
      <span class="em">No projection. No upfront cost. No box to buy.</span>
    </p>

    <div class="hero__actions reveal">
      <a href="#book" class="btn">
        Book a verified pilot
        <span class="btn__arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a href="#calculator" class="btn btn--ghost">
        Model your building's floor
      </a>
    </div>

    <p class="hero__trust reveal">
      The diagnosis is designed by <strong>Cliff Suljak</strong>, an engineer
      the Department of Defense and Department of Energy trusted on sole-source
      work at Sandia National Laboratories and on $600&nbsp;million in
      utility-scale projects at the Salt River Project.
    </p>
  </div>
</section>

<script is:inline>
  (() => {
    const hero = document.querySelector(".hero");
    const spot = hero && hero.querySelector(".hero__spot");
    if (!hero || !spot) return;
    if (!matchMedia("(hover: hover) and (pointer: fine)").matches) return;
    let ticking = false;
    let lx = 0;
    let ly = 0;
    hero.addEventListener(
      "pointermove",
      (e) => {
        const r = hero.getBoundingClientRect();
        lx = e.clientX - r.left;
        ly = e.clientY - r.top;
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            spot.style.setProperty("--mx", lx + "px");
            spot.style.setProperty("--my", ly + "px");
            ticking = false;
          });
        }
      },
      { passive: true },
    );
  })();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(
      168deg,
      var(--hero-from) 0%,
      var(--hero-to) 62%,
      var(--bg) 100%
    );
    padding-block: clamp(5rem, 13vw, 11rem) clamp(4rem, 9vw, 8rem);
  }

  /* PLACEHOLDER hero photograph: dusk luxury-hotel exterior, heavily darkened
     and forest-tinted so ivory headline copy stays readable. Swap the URL for
     a licensed/owned hero image before publishing. */
  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: -3;
    background-image:
      linear-gradient(180deg, transparent 58%, var(--bg) 100%),
      linear-gradient(
        100deg,
        rgba(8, 23, 16, 0.95) 0%,
        rgba(10, 28, 22, 0.82) 46%,
        rgba(12, 33, 27, 0.5) 100%
      ),
      url("https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1920&q=72");
    background-size: cover;
    background-position: center 30%;
  }

  .hero__grid {
    position: absolute;
    inset: -2px;
    z-index: -2;
    background-image:
      linear-gradient(to right, rgba(226, 216, 196, 0.5) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(226, 216, 196, 0.5) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.045;
    mask-image: radial-gradient(
      ellipse 90% 70% at 30% 30%,
      black 35%,
      transparent 80%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 90% 70% at 30% 30%,
      black 35%,
      transparent 80%
    );
  }

  .hero__spot {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s var(--ease-out-quart);
    background: radial-gradient(
      200px circle at var(--mx, 50%) var(--my, 35%),
      rgba(216, 190, 134, 0.18),
      transparent 62%
    );
  }
  @media (hover: hover) and (pointer: fine) {
    .hero:hover .hero__spot {
      opacity: 1;
    }
  }

  .hero__glow {
    position: absolute;
    z-index: -1;
    top: -20%;
    right: -10%;
    width: 50vw;
    height: 50vw;
    max-width: 720px;
    max-height: 720px;
    background: radial-gradient(
      circle,
      rgba(216, 190, 134, 0.14) 0%,
      transparent 65%
    );
    filter: blur(8px);
    pointer-events: none;
  }

  .hero__inner {
    max-width: 62rem;
  }

  .hero__kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--gold-text);
    margin-bottom: var(--space-m);
  }

  .hero__title {
    font-size: var(--step-5);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 17ch;
  }
  .hero__title-accent {
    color: var(--body);
    font-style: italic;
    font-weight: 400;
  }

  .hero__lede {
    margin-top: var(--space-l);
    max-width: 56ch;
  }

  .hero__actions {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .hero__trust {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--muted);
    max-width: 64ch;
  }
  .hero__trust strong {
    color: var(--body);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title.reveal {
      transition-delay: 0.06s;
    }
    .hero__lede.reveal {
      transition-delay: 0.12s;
    }
    .hero__actions.reveal {
      transition-delay: 0.18s;
    }
    .hero__trust.reveal {
      transition-delay: 0.24s;
    }
  }
</style>
