            <stop offset="100%" stop-color="#e0542b" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="redwire" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#ff5a3c" />
            <stop offset="100%" stop-color="#c5301a" />
          </linearGradient>
          <pattern id="blueprint" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M40 0 H0 V40" fill="none" stroke="rgba(120,170,150,0.10)" stroke-width="1" />
          </pattern>
        </defs>

        <!-- the cool "inside": darker, blueprint-gridded -->
        <rect x="0" y="0" width="1000" height="640" fill="#07150f" />
        <rect x="0" y="0" width="1000" height="640" fill="url(#blueprint)" />

        <!-- faint building cross-section behind the wiring -->
        <g stroke="rgba(226,216,196,0.13)" stroke-width="1.2" fill="none">
          <path d="M430 120 H650 V560 H430 Z" />
          <path d="M300 240 H430 M300 240 V560 H430" />
          <path d="M650 240 H780 M780 240 V560 H650" />
          <line x1="280" y1="560" x2="800" y2="560" stroke-width="1.5" />
          {[162, 204, 246, 288, 330, 372, 414, 456, 498].map((y) => (
            <line x1="430" y1={y} x2="650" y2={y} />
          ))}
          {[312, 384, 456].map((y) => (<line x1="300" y1={y} x2="430" y2={y} />))}
          {[312, 384, 456].map((y) => (<line x1="650" y1={y} x2="780" y2={y} />))}
