            <path class="wire wire--run" style={`--d:${(i % 5) * 0.18}s`} d={wire(w[0], w[1], w[2], w[3])} />
          ))}
          {mains.map((w, i) => (
            <path class="wire wire--main" style={`--d:${i * 0.12}s`} d={wire(w[0], w[1], w[2], w[3], w[4], w[5])} />
          ))}
          {branches.map((w, i) => (
            <path class="wire wire--branch" style={`--d:${i * 0.1}s`} d={wire(w[0], w[1], w[2], w[3], w[4], w[5])} />
          ))}
        </g>

        <!-- ===== FAULT 1: rooftop air handler ===== -->
        <g class="dev" data-dev="ahu">
          <circle class="dev__glow" cx="540" cy="96" r="36" fill="url(#heat)" />
          <g class="dev__body">
            <rect x="506" y="80" width="68" height="26" rx="3" />
