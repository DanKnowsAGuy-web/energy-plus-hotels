</section>

<script is:inline>
  (() => {
    const hero = document.querySelector(".hero");
    const scene = hero && hero.querySelector(".hero__scene");
    if (!hero || !scene) return;
    const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const devs = Array.from(scene.querySelectorAll(".dev"));
    const NEAR = 135; // px from lens centre to wake a fault

    const setPos = (x, y) => {
      scene.style.setProperty("--mx", x + "px");
      scene.style.setProperty("--my", y + "px");
    };
    const markNear = (x, y) => {
      const box = scene.getBoundingClientRect();
      for (const d of devs) {
        const m = d.querySelector(".dev__glow") || d;
        const b = m.getBoundingClientRect();
        const hx = b.left + b.width / 2 - box.left;
        const hy = b.top + b.height / 2 - box.top;
        d.classList.toggle("is-near", Math.hypot(hx - x, hy - y) < NEAR);
      }
    };

    // --- Pointer devices: the torch follows the cursor (eased trailing) ---
    if (fine) {
      let tx = 0, ty = 0, lx = 0, ly = 0, raf = 0, primed = false;
      function render() {
        lx += (tx - lx) * (reduce ? 1 : 0.16);
        ly += (ty - ly) * (reduce ? 1 : 0.16);
        setPos(lx, ly);
        markNear(lx, ly);
        if (Math.abs(tx - lx) > 0.5 || Math.abs(ty - ly) > 0.5) {
          raf = requestAnimationFrame(render);
        } else { raf = 0; }
      }
      hero.addEventListener("pointermove", (e) => {
        const box = scene.getBoundingClientRect();
        tx = e.clientX - box.left;
        ty = e.clientY - box.top;
        if (!primed) { lx = tx; ly = ty; primed = true; }
        hero.classList.add("is-live");
        if (!raf) raf = requestAnimationFrame(render);
      }, { passive: true });
      hero.addEventListener("pointerleave", () => {
        hero.classList.remove("is-live");
        devs.forEach((d) => d.classList.remove("is-near"));
      });
      return;
    }

    // --- No pointer + reduced motion: leave the static ghost (CSS) ---
    if (reduce) return;

    // --- Touch: a gentle self-guided torch that searches, finds, moves on ---
    const order = ["ahu", "fridge", "switch", "pump", "boiler", "chiller", "laundry"]
      .map((n) => scene.querySelector('.dev[data-dev="' + n + '"]'))
      .filter(Boolean);
    if (!order.length) return;
    const centerOf = (d) => {
      const m = d.querySelector(".dev__glow") || d;
      const b = m.getBoundingClientRect();
      const box = scene.getBoundingClientRect();
      return { x: b.left + b.width / 2 - box.left, y: b.top + b.height / 2 - box.top };
    };
    const ease = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const TRAVEL = 1700, HOLD = 1300;
    let oi = 0, phase = "hold", tstart = 0, from = null, to = null, started = false;
    hero.classList.add("is-auto", "is-live");
    function tour(ts) {
      if (!started) {
        to = centerOf(order[0]); from = { x: to.x, y: to.y };
        setPos(to.x, to.y); tstart = ts; started = true;
      }
      if (phase === "travel") {
        const t = Math.min(1, (ts - tstart) / TRAVEL);
        const e = ease(t);
        const x = from.x + (to.x - from.x) * e;
        const y = from.y + (to.y - from.y) * e;
        setPos(x, y); markNear(x, y);
        if (t >= 1) { phase = "hold"; tstart = ts; }
      } else {
        setPos(to.x, to.y); markNear(to.x, to.y);
        if (ts - tstart >= HOLD) {
          oi = (oi + 1) % order.length;
          from = { x: to.x, y: to.y };
          to = centerOf(order[oi]);
          phase = "travel"; tstart = ts;
        }
      }
      requestAnimationFrame(tour);
    }
    requestAnimationFrame(tour);
  })();
</script>

