---
// Water analogy, corrected: both pipes carry the same calm flow at the same
// meter reading. The second pipe is full of air bubbles, and the meter can't
// tell water from air. You're billed for the air. Distortion works the same
// way at your electric meter. Sets up the Harmonizer scene that follows.
const W = 640;
const PIPE_H = 110;

function water(y: number) {
  return `M16 ${y} L${W - 16} ${y}`;
}

// bubbles: lane y, radius, drift duration s, delay s
// (doubled count, radii x1.3 for a denser, more visible air load)
const bubbles = [
  { y: 30, r: 7.8, dur: 9, delay: 0 },
  { y: 62, r: 5.2, dur: 7, delay: -2.5 },
  { y: 44, r: 6.5, dur: 11, delay: -5 },
  { y: 76, r: 4.4, dur: 8, delay: -1.2 },
  { y: 36, r: 3.9, dur: 6.4, delay: -3.8 },
  { y: 70, r: 7, dur: 10, delay: -7 },
  { y: 52, r: 5.8, dur: 8.6, delay: -4.4 },
  { y: 26, r: 4.6, dur: 7.4, delay: -6.1 },
  { y: 84, r: 6.2, dur: 9.6, delay: -2 },
  { y: 58, r: 3.9, dur: 6.8, delay: -0.7 },
  { y: 40, r: 7.2, dur: 10.5, delay: -8.3 },
  { y: 68, r: 4.9, dur: 7.8, delay: -3.1 },
];
---

<section class="flow" aria-labelledby="flow-title">
  <div class="container">
    <div class="flow__head reveal">
      <h2 class="flow__title" id="flow-title">
        Think of water moving through a pipe.
      </h2>
      <p class="flow__lede lede">
        Both pipes below show the same meter reading. One carries pure water.
        The other carries water full of air bubbles, and the meter can't tell
        the difference: it bills every gallon of flow, air included. You
        thought you were paying for water. Part of it was air. Distorted power
        works exactly this way at your electric meter, and the air is what
        beats up your equipment on the way through.
      </p>
    </div>

    <figure class="flow__fig reveal" style="--i: 1">
      <div class="flow__pipe">
        <svg viewBox={`0 0 ${W} ${PIPE_H}`} preserveAspectRatio="none" aria-hidden="true">
          <rect class="flow__wall flow__wall--pure" x="2" y="2" width={W - 4} height={PIPE_H - 4} rx="12"></rect>
          <path class="flow__line" d={water(32)} style="--d: 0s"></path>
          <path class="flow__line" d={water(55)} style="--d: -1.1s"></path>
          <path class="flow__line" d={water(78)} style="--d: -2.2s"></path>
        </svg>
        <figcaption class="flow__cap">
          <span class="flow__cap-name flow__cap-name--pure">Pure water</span>
          <span class="flow__cap-note">every gallon on the meter is water</span>
        </figcaption>
      </div>

      <div class="flow__pipe">
        <svg viewBox={`0 0 ${W} ${PIPE_H}`} preserveAspectRatio="none" aria-hidden="true">
          <rect class="flow__wall flow__wall--air" x="2" y="2" width={W - 4} height={PIPE_H - 4} rx="12"></rect>
          <path class="flow__line" d={water(32)} style="--d: 0s"></path>
          <path class="flow__line" d={water(55)} style="--d: -1.1s"></path>
          <path class="flow__line" d={water(78)} style="--d: -2.2s"></path>
          {
            bubbles.map((b) => (
              <circle
                class="flow__bubble"
                cy={b.y}
                r={b.r}
                style={`--dur: ${b.dur}s; --delay: ${b.delay}s`}
              />
            ))
          }
        </svg>
        <figcaption class="flow__cap">
          <span class="flow__cap-name flow__cap-name--air">Water + air</span>
          <span class="flow__cap-note">same meter reading, part of it is air</span>
        </figcaption>
      </div>
    </figure>

    <p class="flow__close reveal" style="--i: 2">
      Same bill. Different delivery. Here is what the air costs a hotel.
    </p>
  </div>
</section>

<style>
  .flow {
    padding-block: clamp(4rem, 9vw, var(--space-3xl)) clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
    background:
      radial-gradient(
        ellipse 55% 45% at 10% 0%,
        rgba(91, 157, 194, 0.05),
        transparent 70%
      ),
      var(--bg);
  }
  .flow__head {
    max-width: 56rem;
  }
  .flow__title {
    font-size: var(--step-3);
    max-width: 18ch;
  }
  .flow__lede {
    margin-top: var(--space-m);
    max-width: 60ch;
  }

  .flow__fig {
    margin: var(--space-xl) 0 0;
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
  }
  .flow__pipe {
    position: relative;
  }
  .flow__pipe svg {
    display: block;
    width: 100%;
    height: clamp(86px, 14vw, 118px);
  }
  .flow__wall {
    fill: rgba(255, 255, 255, 0.025);
    stroke-width: 1.5;
  }
  .flow__wall--pure {
    stroke: rgba(91, 157, 194, 0.4);
  }
  .flow__wall--air {
    stroke: rgba(224, 90, 43, 0.4);
  }

  /* identical calm water in both pipes: the flow is not the problem */
  .flow__line {
    fill: none;
    stroke: #5b9dc2;
    stroke-width: 2.2;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-dasharray: 26 18;
    filter: drop-shadow(0 0 5px rgba(91, 157, 194, 0.4));
  }

  /* the air: red bubbles riding the same flow */
  .flow__bubble {
    fill: rgba(224, 90, 43, 0.16);
    stroke: #e05a2b;
    stroke-width: 1.4;
    filter: drop-shadow(0 0 4px rgba(224, 90, 43, 0.5));
    transform: translateX(-30px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .flow__line {
      animation: flowDash 7s linear infinite;
      animation-delay: var(--d, 0s);
    }
    @keyframes flowDash {
      from {
        stroke-dashoffset: 0;
      }
      to {
        stroke-dashoffset: -440;
      }
    }
    .flow__bubble {
      animation: bubbleDrift var(--dur, 9s) linear infinite;
      animation-delay: var(--delay, 0s);
    }
    /* drift left to right with a gentle float; x is linear, y bobs */
    @keyframes bubbleDrift {
      0% {
        transform: translate(-30px, 0);
        opacity: 0;
      }
      6% {
        opacity: 1;
      }
      25% {
        transform: translate(150px, -5px);
      }
      50% {
        transform: translate(330px, 3px);
      }
      75% {
        transform: translate(510px, -4px);
      }
      94% {
        opacity: 1;
      }
      100% {
        transform: translate(690px, 2px);
        opacity: 0;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* static: bubbles parked mid-pipe so the picture still reads */
    .flow__bubble {
      transform: translateX(300px);
    }
    .flow__bubble:nth-of-type(odd) {
      transform: translateX(180px);
    }
  }

  .flow__cap {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-top: 0.6rem;
  }
  .flow__cap-name {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .flow__cap-name--pure {
    color: #5b9dc2;
  }
  .flow__cap-name--air {
    color: #e05a2b;
  }
  .flow__cap-note {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .flow__close {
    margin-top: var(--space-xl);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--ink);
    max-width: 44ch;
  }
</style>
