---
// Water analogy: same gallons, different flow. Laminar lines run calm; the
// turbulent pipe carries the same volume but rattles everything it touches.
// Sets up the Harmonizer scene that follows. Paths are compile-time; motion
// is dash-flow only (cheap, smooth), with static fallback for reduced motion.
const W = 640;
const PIPE_H = 110;

function laminar(y: number) {
  return `M16 ${y} L${W - 16} ${y}`;
}

function turbulent(yBase: number, seed: number, wob: number) {
  const N = 96;
  let d = "";
  for (let i = 0; i <= N; i++) {
    const x = 16 + (i / N) * (W - 32);
    const t = (i / N) * Math.PI * 2;
    const y =
      yBase +
      wob * (0.55 * Math.sin(t * 9 + seed) + 0.3 * Math.sin(t * 17 + seed * 2.3) + 0.18 * Math.sin(t * 29 + seed * 4.1));
    d += (i === 0 ? "M" : "L") + x.toFixed(1) + " " + y.toFixed(1) + " ";
  }
  return d.trim();
}
---

<section class="flow" aria-labelledby="flow-title">
  <div class="container">
    <div class="flow__head reveal">
      <h2 class="flow__title" id="flow-title">
        Think of water moving through a pipe.
      </h2>
      <p class="flow__lede lede">
        Both pipes below deliver the same gallons. One delivers them calmly.
        The other arrives churning, and the turbulence hammers the pump, the
        joints, and everything downstream. Electricity behaves the same way:
        the meter reads the same, but distorted power beats your equipment to
        death on the way in.
      </p>
    </div>

    <figure class="flow__fig reveal" style="--i: 1">
      <div class="flow__pipe flow__pipe--smooth">
        <svg viewBox={`0 0 ${W} ${PIPE_H}`} preserveAspectRatio="none" aria-hidden="true">
          <rect class="flow__wall" x="2" y="2" width={W - 4} height={PIPE_H - 4} rx="12"></rect>
          <path class="flow__line flow__line--s" d={laminar(32)} style="--d: 0s"></path>
          <path class="flow__line flow__line--s" d={laminar(55)} style="--d: -1.1s"></path>
          <path class="flow__line flow__line--s" d={laminar(78)} style="--d: -2.2s"></path>
        </svg>
        <figcaption class="flow__cap flow__cap--s">
          <span class="flow__cap-name">Smooth flow</span>
          <span class="flow__cap-note">every gallon arrives doing work</span>
        </figcaption>
      </div>

      <div class="flow__pipe flow__pipe--rough">
        <svg viewBox={`0 0 ${W} ${PIPE_H}`} preserveAspectRatio="none" aria-hidden="true">
          <rect class="flow__wall flow__wall--rough" x="2" y="2" width={W - 4} height={PIPE_H - 4} rx="12"></rect>
          <path class="flow__line flow__line--r" d={turbulent(32, 1.3, 11)} style="--d: 0s"></path>
          <path class="flow__line flow__line--r" d={turbulent(55, 3.7, 14)} style="--d: -0.9s"></path>
          <path class="flow__line flow__line--r" d={turbulent(78, 6.1, 11)} style="--d: -1.7s"></path>
        </svg>
        <figcaption class="flow__cap flow__cap--r">
          <span class="flow__cap-name">Turbulent flow</span>
          <span class="flow__cap-note">same gallons, hammering the system</span>
        </figcaption>
      </div>
    </figure>

    <p class="flow__close reveal" style="--i: 2">
      Same delivery. Different violence. Here is the machine that calms the
      flow.
    </p>
  </div>
</section>

<style>
  .flow {
    padding-block: clamp(4rem, 9vw, var(--space-3xl)) clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
    background:
      radial-gradient(
        ellipse 55% 45% at 10% 0%,
        rgba(91, 194, 162, 0.04),
        transparent 70%
      ),
      var(--bg);
  }
  .flow__head {
    max-width: 56rem;
  }
  .flow__title {
    font-size: var(--step-3);
    max-width: 18ch;
  }
  .flow__lede {
    margin-top: var(--space-m);
    max-width: 58ch;
  }

  .flow__fig {
    margin: var(--space-xl) 0 0;
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
  }
  .flow__pipe {
    position: relative;
  }
  .flow__pipe svg {
    display: block;
    width: 100%;
    height: clamp(86px, 14vw, 118px);
  }
  .flow__wall {
    fill: rgba(255, 255, 255, 0.025);
    stroke: rgba(91, 194, 162, 0.35);
    stroke-width: 1.5;
  }
  .flow__wall--rough {
    stroke: rgba(224, 90, 43, 0.4);
  }

  .flow__line {
    fill: none;
    stroke-width: 2.2;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
  }
  .flow__line--s {
    stroke: var(--mint);
    stroke-dasharray: 26 18;
    filter: drop-shadow(0 0 5px rgba(91, 194, 162, 0.4));
  }
  .flow__line--r {
    stroke: #e05a2b;
    stroke-dasharray: 10 9;
    filter: drop-shadow(0 0 5px rgba(224, 90, 43, 0.35));
  }
  @media (prefers-reduced-motion: no-preference) {
    .flow__line {
      animation: flowDash 7s linear infinite;
      animation-delay: var(--d, 0s);
    }
    .flow__line--r {
      animation-duration: 3.2s;
    }
    @keyframes flowDash {
      from {
        stroke-dashoffset: 0;
      }
      to {
        stroke-dashoffset: -440;
      }
    }
    .flow__pipe--rough svg {
      animation: pipeRattle 0.42s ease-in-out infinite;
    }
    @keyframes pipeRattle {
      0%, 100% { transform: translate(0, 0); }
      30% { transform: translate(0.7px, -0.5px); }
      70% { transform: translate(-0.7px, 0.5px); }
    }
  }

  .flow__cap {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-top: 0.6rem;
  }
  .flow__cap-name {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .flow__cap--s .flow__cap-name {
    color: var(--mint);
  }
  .flow__cap--r .flow__cap-name {
    color: #e05a2b;
  }
  .flow__cap-note {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .flow__close {
    margin-top: var(--space-xl);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--ink);
    max-width: 44ch;
  }
</style>
