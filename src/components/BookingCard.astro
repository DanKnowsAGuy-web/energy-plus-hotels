---
// Inline booking card, dark "Mix" theme. Collapsed by default; any "Book your
// Verified Savings Pilot" CTA (a[href="#book"]) opens it and scrolls it into
// view. The Google inline scheduler iframe is lazy: its src is only set on the
// first open, so the page doesn't load Google on every visit. The slot-picker
// itself is Google's (cross-origin, light) and sits in an off-white frame so
// it doesn't look bolted onto the dark page.
const SCHEDULE_URL =
  "https://calendar.google.com/calendar/appointments/schedules/AcZssZ3vvVPAZ3Hxk10D2T5Q2PW9kkX-yumqn_iupMIUULQKsv2RmSt-cLMi6KAHqkPW5H2khzD1ukM9?gv=true";
---

<div class="bookcal" id="booking" aria-hidden="true">
  <div class="bookcal__bar">
    <span class="bookcal__label">Pick a time, it books straight onto our calendar</span>
    <button type="button" class="bookcal__close" data-book-close aria-label="Close the scheduler">
      <span aria-hidden="true">&times;</span>
    </button>
  </div>
  <div class="bookcal__frame">
    <iframe
      class="bookcal__iframe"
      title="Energy Plus appointment booking"
      loading="lazy"
      data-src={SCHEDULE_URL}></iframe>
  </div>
</div>

<script is:inline>
  (() => {
    const card = document.getElementById("booking");
    if (!card) return;
    const iframe = card.querySelector(".bookcal__iframe");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const open = () => {
      if (iframe && !iframe.getAttribute("src") && iframe.dataset.src) {
        iframe.src = iframe.dataset.src;
      }
      card.classList.add("is-open");
      card.setAttribute("aria-hidden", "false");
      setTimeout(
        () => card.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "center" }),
        reduce ? 0 : 360,
      );
    };
    const close = () => {
      card.classList.remove("is-open");
      card.setAttribute("aria-hidden", "true");
    };
    document.addEventListener("click", (e) => {
      if (e.target.closest("[data-book-close]")) { e.preventDefault(); close(); return; }
      const trigger = e.target.closest('a[href="#book"]');
      if (trigger) open();
    });
  })();
</script>

<style>
  .bookcal {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    border: 1px solid transparent;
    border-radius: var(--radius);
    transition:
      max-height 0.55s var(--ease-out-quart),
      opacity 0.4s ease,
      margin-top 0.55s var(--ease-out-quart);
  }
  .bookcal.is-open {
    max-height: 920px;
    opacity: 1;
    margin-top: var(--space-l);
    border-color: var(--line-strong);
    background: var(--surface);
    box-shadow: var(--shadow-lift, 0 22px 50px -24px rgba(0, 0, 0, 0.85));
  }
  .bookcal__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: 0.85rem 1.1rem;
  }
  .bookcal__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--gold-text);
  }
  .bookcal__close {
    flex: none;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--body);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .bookcal__close:hover { color: var(--ink); border-color: var(--gold-text); background: var(--gold-soft); }
  .bookcal__close:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }

  /* off-white frame so Google's light picker blends, like the .paper inserts */
  .bookcal__frame {
    margin: 0 0.7rem 0.7rem;
    padding: 0.6rem;
    background: #f4f6fa;
    border-radius: var(--radius-s);
  }
  .bookcal__iframe {
    display: block;
    width: 100%;
    height: 640px;
    border: 0;
    border-radius: 8px;
    background: #fff;
  }

  @media (max-width: 52rem) {
    .bookcal.is-open { max-height: 1000px; }
    .bookcal__iframe { height: 700px; }
    .bookcal__label { font-size: 0.66rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bookcal { transition: opacity 0.3s ease; }
  }
</style>
