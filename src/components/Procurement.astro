---
// "Meet your procurement officer." The guide-authority payoff to the insulin
// parable, reformatted as a stat strip: Cliff's photo + scannable credential
// chips, so the authority lands in two seconds instead of a bio paragraph.
//
// PLACEHOLDER credential wording: confirm Cliff's exact Sandia / DOD / DOE
// relationship and the dollar figure with him before publishing. He held a
// sole-source contract with Sandia, doing the work for (not under) the DOD/DOE.
import cliff from "../assets/cliff.jpeg";

const stats = [
  { fig: "42+", label: "years running large-scale infrastructure" },
  { fig: "$600M+", label: "in projects at the Salt River Project" },
  { fig: "Sole source", label: "trusted by Sandia National Laboratories" },
  { fig: "DOD · DOE", label: "energy technology, sourced for both" },
];
---

<section class="section proc" id="procurement" aria-labelledby="proc-title">
  <div class="container">
    <p class="proc__kicker reveal">The exam needs an examiner</p>
    <div class="proc__grid">
      <figure class="proc__person reveal">
        <img
          class="proc__photo"
          src={cliff.src}
          width={cliff.width}
          height={cliff.height}
          loading="lazy"
          alt="Cliff Suljak, Chief Engineer"
        />
        <figcaption class="proc__cap">
          <span class="proc__name">Cliff Suljak</span>
          <span class="proc__role">Chief Engineer</span>
        </figcaption>
      </figure>

      <div class="proc__main reveal">
        <h2 class="proc__title" id="proc-title">Meet your procurement officer.</h2>
        <p class="proc__body">
          When buying the wrong technology wasn't an option, this is who they
          trusted. Now he runs the exam on your building and buys on your
          behalf, not the vendor's.
        </p>

        <ul class="proc__stats">
          {
            stats.map((s) => (
              <li class="proc__stat">
                <span class="proc__fig">{s.fig}</span>
                <span class="proc__label">{s.label}</span>
              </li>
            ))
          }
        </ul>

        <p class="proc__refrain">That's the whole idea.</p>

        <div class="proc__cta">
          <a href="#book" class="btn">
            Book a verified pilot
            <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a href="#power" class="proc__more">
            or keep reading to see what the exam finds
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .proc {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(
        ellipse 50% 50% at 12% 0%,
        rgba(194, 163, 104, 0.06),
        transparent 70%
      ),
      var(--bg);
  }
  .proc__kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-text);
    margin-bottom: var(--space-m);
  }

  .proc__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: center;
  }
  @media (max-width: 760px) {
    .proc__grid { grid-template-columns: 1fr; gap: var(--space-l); }
  }

  .proc__person { margin: 0; }
  .proc__photo {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    filter: grayscale(0.55) sepia(0.18) hue-rotate(78deg) saturate(0.7) brightness(0.95);
  }
  @media (max-width: 760px) {
    .proc__photo { max-width: 18rem; }
  }
  .proc__cap {
    margin-top: var(--space-s);
    display: flex;
    flex-direction: column;
  }
  .proc__name {
    font-size: var(--step-1);
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .proc__role {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .proc__title { font-size: var(--step-3); max-width: 18ch; }
  .proc__body {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--body);
    max-width: 56ch;
  }

  .proc__stats {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m) var(--space-l);
    max-width: 48rem;
  }
  @media (max-width: 460px) {
    .proc__stats { grid-template-columns: 1fr; gap: var(--space-s); }
  }
  .proc__stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-left: var(--space-s);
    border-left: 2px solid var(--gold-soft);
  }
  .proc__fig {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    letter-spacing: -0.01em;
    color: var(--gold-text);
  }
  .proc__label {
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--body);
  }

  .proc__refrain {
    margin-top: var(--space-l);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-2);
    letter-spacing: -0.01em;
    color: var(--gold-text);
  }
  .proc__cta {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
  }
  .proc__more {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-0);
    color: var(--muted);
    border-bottom: 1px dotted var(--line-strong);
    padding-bottom: 1px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .proc__more:hover { color: var(--gold-text); border-color: var(--gold-text); }
</style>
