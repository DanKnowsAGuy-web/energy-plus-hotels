---
// "You don't give insulin to someone who isn't diabetic." The parable of the
// prescription without the exam, illustrated as a tale of two buildings: the
// same box installed in both, a big result in one, nothing in the other.
// The two buildings stack in a right rail beside the text; meters and labels
// live in HTML so they stay legible at the rail's narrow width.
const cols = [40, 55, 70];
const rows = [36, 62, 88];
const owins: { x: number; y: number }[] = [];
for (const y of rows) for (const x of cols) owins.push({ x, y });
---

<section class="section par" id="parable" aria-labelledby="par-title">
  <div class="container par__grid">
    <div class="par__head reveal">
      <h2 class="par__title" id="par-title">
        You don't give insulin to someone who isn't diabetic.
      </h2>
      <p class="par__body">
        Yet that's how energy efficiency is sold: a prescription, without the
        exam. The vendor arrives with the one medicine they carry, the box
        that worked on somebody else's building. They didn't lie to you. They
        just never diagnosed whether it was the right medicine for yours.
      </p>
      <p class="par__body">
        We sit on your side of the table instead. We don't manufacture
        equipment and we don't sell a box, so there's no product hiding behind
        the diagnosis. We purchase on your behalf, and our engineers modify
        equipment so it fits your building. The verification is the product;
        the equipment is just whatever it points to. We prescribe only after
        the exam.
      </p>
      <p class="par__refrain reveal">
        We don't work for the vendors. We work for you.
      </p>
      <p class="par__bet reveal">
        If someone shows us a solution we don't have access to, we'll pay them
        a finder's fee.
      </p>
    </div>

    <figure class="par__fig reveal" id="par-fig">
      <p class="par__same">The same box, installed the same way.</p>

      <div class="par__case">
        <svg class="par__b" viewBox="0 0 120 150" role="img"
          aria-label="The right building for the box: its bill falls 14 percent and its windows warm.">
          <line class="par__ground" x1="14" y1="132" x2="106" y2="132"></line>
          <rect class="par__shell" x="30" y="22" width="60" height="110" rx="2"></rect>
          {owins.map((w) => (
            <rect class="par__win par__win--a" x={w.x} y={w.y} width="11" height="9" rx="1"></rect>
          ))}
          <rect class="par__panel" x="54" y="108" width="12" height="22"></rect>
          <g class="par__box" id="par-box-a">
            <rect class="par__box-body" x="45" y="8" width="30" height="16" rx="2"></rect>
            <line class="par__box-line" x1="51" y1="14" x2="69" y2="14"></line>
            <line class="par__box-line" x1="51" y1="18" x2="69" y2="18"></line>
          </g>
        </svg>
        <div class="par__info">
          <span class="par__meter par__meter--a" id="par-meter-a">0%</span>
          <span class="par__tag">Right building for it</span>
        </div>
      </div>

      <div class="par__case">
        <svg class="par__b" viewBox="0 0 120 150" role="img"
          aria-label="The wrong building for the box: the same install, no change at the meter.">
          <line class="par__ground" x1="14" y1="132" x2="106" y2="132"></line>
          <rect class="par__shell" x="30" y="22" width="60" height="110" rx="2"></rect>
          {owins.map((w) => (
            <rect class="par__win" x={w.x} y={w.y} width="11" height="9" rx="1"></rect>
          ))}
          <rect class="par__panel" x="54" y="108" width="12" height="22"></rect>
          <g class="par__box" id="par-box-b">
            <rect class="par__box-body" x="45" y="8" width="30" height="16" rx="2"></rect>
            <line class="par__box-line" x1="51" y1="14" x2="69" y2="14"></line>
            <line class="par__box-line" x1="51" y1="18" x2="69" y2="18"></line>
          </g>
        </svg>
        <div class="par__info">
          <span class="par__meter" id="par-meter-b">&nbsp;</span>
          <span class="par__tag">Wrong patient</span>
        </div>
      </div>

      <figcaption class="par__closer">
        Same box, different buildings. The difference was never the medicine.
        It was the missing exam.
      </figcaption>
    </figure>
  </div>
</section>

<script is:inline>
  (() => {
    const fig = document.getElementById("par-fig");
    if (!fig) return;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const meterA = document.getElementById("par-meter-a");
    const meterB = document.getElementById("par-meter-b");

    const finish = (animate) => {
      fig.classList.add("is-installed");
      const settle = () => {
        fig.classList.add("is-resolved");
        meterB.textContent = "no change";
        if (!animate) {
          meterA.textContent = "-14%";
          return;
        }
        const t0 = performance.now();
        const dur = 1100;
        meterA.textContent = "-14%";
        const tick = (now) => {
          const p = Math.min((now - t0) / dur, 1);
          const e = 1 - Math.pow(1 - p, 4);
          meterA.textContent = "-" + Math.round(14 * e) + "%";
          if (p < 1) requestAnimationFrame(tick);
          else meterA.textContent = "-14%";
        };
        requestAnimationFrame(tick);
      };
      if (animate) setTimeout(settle, 700);
      else settle();
    };

    if (reduce || !("IntersectionObserver" in window)) {
      finish(false);
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            io.disconnect();
            finish(true);
          }
        }
      },
      { threshold: 0.4 },
    );
    io.observe(fig);
  })();
</script>

<style>
  .par {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(ellipse 55% 45% at 90% 0%, rgba(194, 163, 104, 0.05), transparent 70%),
      var(--bg);
  }
  .par__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(230px, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  @media (max-width: 820px) {
    .par__grid { grid-template-columns: 1fr; }
  }

  .par__title { font-size: var(--step-3); max-width: 24ch; }
  .par__body {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--body);
    max-width: 60ch;
  }
  .par__refrain {
    margin-top: var(--space-l);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-2);
    letter-spacing: -0.01em;
    color: var(--gold-text);
    max-width: 28ch;
  }
  .par__bet {
    margin-top: var(--space-m);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--muted);
    max-width: 48ch;
  }

  /* Right rail: the two cases stacked, each a building + its readout. */
  .par__fig {
    margin: 0;
    padding: var(--space-m);
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.012);
  }
  @media (max-width: 820px) {
    .par__fig { max-width: 22rem; }
  }
  .par__same {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.05em;
    color: var(--muted);
    margin-bottom: var(--space-s);
  }
  .par__case {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    padding: var(--space-s) 0;
  }
  .par__case + .par__case {
    border-top: 1px solid var(--line);
  }
  .par__b { width: 68px; height: auto; flex: none; }
  .par__info { display: flex; flex-direction: column; gap: 2px; }
  .par__meter {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transition: color 0.5s ease;
  }
  .par__fig.is-resolved .par__meter--a { color: var(--mint); }
  .par__tag {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .par__ground { stroke: var(--line-strong); stroke-width: 1.5; stroke-dasharray: 4 5; }
  .par__shell { fill: rgba(255, 255, 255, 0.02); stroke: var(--line-strong); stroke-width: 1.5; }
  .par__win {
    fill: rgba(226, 216, 196, 0.07);
    stroke: var(--line);
    stroke-width: 0.6;
    transition: fill 0.7s ease, stroke 0.7s ease;
  }
  .par__fig.is-resolved .par__win--a {
    fill: rgba(216, 190, 134, 0.5);
    stroke: var(--gold-text);
  }
  .par__panel { fill: rgba(226, 216, 196, 0.08); stroke: var(--line); stroke-width: 1; }

  .par__box {
    opacity: 0;
    transform: translateY(-34px);
    transition: transform 0.6s var(--ease-out-quart), opacity 0.4s ease;
  }
  .par__fig.is-installed .par__box {
    opacity: 1;
    transform: translateY(0);
  }
  .par__box-body { fill: var(--surface-2); stroke: var(--gold); stroke-width: 1.4; }
  .par__box-line { stroke: var(--gold-text); stroke-width: 1.2; }

  .par__closer {
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .par__box { transition: none; opacity: 1; transform: none; }
  }
</style>
