---
// Reusable CTA pair: the primary "Book your Verified Savings Pilot" plus a
// secondary "Just text the founder" that expands an inline message panel
// directly beneath (no popup). Drop it anywhere a Book CTA belongs.
// Pass size="lg" to match the large final CTA. One delegated script handles
// every instance (guarded so it only initializes once).
const { size = "" } = Astro.props;
const lg = size === "lg" ? " btn--lg" : "";
const PHONE_DISPLAY = "(864) 777-0688";
const MSG =
  "Hi Dan, I run a hotel and I'd like to see what real energy savings could look like at my property, without the sales song and dance. What would a Verified Savings Pilot find for a building like mine?";
---

<div class="tf-cta">
  <div class="tf-cta__row">
    <a href="#book" class={`btn${lg}`}>
      Book your Verified Savings Pilot
      <span class="btn__arrow" aria-hidden="true">&rarr;</span>
    </a>
    <button type="button" class={`btn btn--ghost js-tf-toggle${lg}`} aria-expanded="false">
      Just text the founder
    </button>
  </div>
  <div class="tf-panel" role="group" aria-label="Text the founder">
    <p class="tf-panel__to">To <span>Dan &middot; {PHONE_DISPLAY}</span></p>
    <textarea class="tf-panel__msg js-tf-msg" rows="3" spellcheck="false">{MSG}</textarea>
    <div class="tf-panel__foot">
      <span class="tf-panel__hint">Opens in your messages, ready to send.</span>
      <a class="tf-panel__send js-tf-send" href="#" data-phone="+18647770688">
        Send message
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12 h13 M12 5 l7 7 -7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    if (window.__tfInit) return;
    window.__tfInit = true;
    const ua = navigator.userAgent || "";
    const isIOS = /iP(hone|ad|od)/.test(ua) || (/Mac/.test(ua) && "ontouchend" in document);
    const buildFor = (cta) => {
      if (!cta) return;
      const msg = cta.querySelector(".js-tf-msg");
      const send = cta.querySelector(".js-tf-send");
      if (!msg || !send) return;
      const phone = send.getAttribute("data-phone") || "";
      send.href = "sms:" + phone + (isIOS ? "&" : "?") + "body=" + encodeURIComponent(msg.value);
    };
    const init = () => {
      document.addEventListener("click", (e) => {
        const toggle = e.target.closest(".js-tf-toggle");
        if (!toggle) return;
        const cta = toggle.closest(".tf-cta");
        const panel = cta && cta.querySelector(".tf-panel");
        if (!panel) return;
        const open = !panel.classList.contains("is-open");
        panel.classList.toggle("is-open", open);
        toggle.setAttribute("aria-expanded", String(open));
        if (open) { buildFor(cta); const m = cta.querySelector(".js-tf-msg"); if (m) setTimeout(() => m.focus(), 80); }
      });
      document.addEventListener("input", (e) => {
        const t = e.target;
        if (t && t.classList && t.classList.contains("js-tf-msg")) buildFor(t.closest(".tf-cta"));
      });
      document.querySelectorAll(".tf-cta").forEach(buildFor);
    };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
    else init();
  })();
</script>

<style>
  .tf-cta__row { display: flex; flex-wrap: wrap; gap: var(--space-s); align-items: center; }
  .tf-panel {
    overflow: hidden; max-height: 0; opacity: 0;
    transition: max-height 0.4s var(--ease-out-quart), opacity 0.3s ease, margin-top 0.4s var(--ease-out-quart);
  }
  .tf-panel.is-open { max-height: 28rem; opacity: 1; margin-top: var(--space-m); }
  .tf-panel__to { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); }
  .tf-panel__to span { color: var(--body); }
  .tf-panel__msg {
    width: 100%; max-width: 38rem; margin-top: 0.5rem; resize: vertical;
    background: var(--mint-soft); color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--mint) 38%, transparent);
    border-radius: 16px; padding: 0.75rem 0.95rem;
    font-family: var(--font-sans); font-size: var(--step-0); line-height: 1.5;
  }
  .tf-panel__msg:focus-visible { outline: 2px solid var(--mint); outline-offset: 2px; }
  .tf-panel__foot {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-s); flex-wrap: wrap; max-width: 38rem; margin-top: 0.6rem;
  }
  .tf-panel__hint { font-size: 0.72rem; color: var(--muted); }
  .tf-panel__send {
    display: inline-flex; align-items: center; gap: 0.5em;
    background: var(--mint); color: var(--bg);
    font-family: var(--font-sans); font-weight: 600; font-size: var(--step--1);
    padding: 0.6em 1.1em; border-radius: 999px; text-decoration: none; cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .tf-panel__send svg { width: 1.05em; height: 1.05em; }
  .tf-panel__send:hover { transform: translateY(-1px); background: color-mix(in srgb, var(--mint) 86%, white); }
</style>
