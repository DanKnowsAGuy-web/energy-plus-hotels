---
// The calculator proper: the slimmed savings estimator (public/calc/) embedded
// via auto-height iframe. The page above does the persuading; this is the
// instrument that finishes the story with their number.
const calcUrl = `${import.meta.env.BASE_URL}/calc/`.replace(/\/\/+/g, "/");
---

<section class="section est" id="calculator" aria-labelledby="est-title">
  <div class="container">
    <div class="est__head reveal">
      <h2 class="est__title" id="est-title">
        Now run your own number.
      </h2>
      <p class="est__lede lede">
        Everything above is the why. This is the how much: your hotel type,
        your electricity spend, your state. The output is the conservative
        floor, and the real number is measured at your meter during the pilot,
        on our dime.
      </p>
    </div>
  </div>

  <div class="est__frame-wrap reveal" style="--i: 1">
    <iframe
      id="est-frame"
      class="est__frame"
      src={calcUrl}
      title="Energy Plus Hotels savings calculator"
      loading="lazy"
      scrolling="no"></iframe>
  </div>
</section>

<script is:inline>
  (() => {
    const frame = document.getElementById("est-frame");
    if (!frame) return;
    addEventListener("message", (e) => {
      const d = e.data;
      if (d && d.type === "calc-height" && Number.isFinite(d.height)) {
        frame.style.height = Math.ceil(d.height) + "px";
      }
    });
  })();
</script>

<style>
  .est {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(
        ellipse 60% 45% at 50% 0%,
        rgba(194, 163, 104, 0.06),
        transparent 70%
      ),
      var(--bg);
  }
  .est__head {
    max-width: 54rem;
  }
  .est__title {
    font-size: var(--step-3);
    max-width: 18ch;
  }
  .est__lede {
    margin-top: var(--space-m);
  }

  .est__frame-wrap {
    margin-top: var(--space-xl);
    padding-inline: clamp(0.5rem, 3vw, 2rem);
  }
  .est__frame {
    display: block;
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
    height: 920px; /* sensible default until the first height message lands */
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 40px 90px -55px rgba(0, 0, 0, 0.75);
  }
</style>
