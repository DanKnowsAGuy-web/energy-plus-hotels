---
// Native savings estimator. Math and data ported 1:1 from the verified
// commercial estimator (hotel parameters): harmonization floor 8% of spend,
// cooling optimization 15-55% of cooling spend (state cooling share), demand
// response 5% x 40% demand portion, outdoor lighting 4-9% x 0.88, state rate
// escalation tiers, and the Section 179D deduction at $5.94/sqft.
const STATE_COOL: Record<string, number> = {
  Alabama: 65, Alaska: 22, Arizona: 80, Arkansas: 65, California: 50,
  Colorado: 35, Connecticut: 35, Delaware: 50, "District of Columbia": 50,
  Florida: 80, Georgia: 65, Hawaii: 80, Idaho: 22, Illinois: 35, Indiana: 35,
  Iowa: 35, Kansas: 50, Kentucky: 50, Louisiana: 80, Maine: 22, Maryland: 50,
  Massachusetts: 35, Michigan: 22, Minnesota: 22, Mississippi: 65,
  Missouri: 50, Montana: 22, Nebraska: 35, Nevada: 65, "New Hampshire": 22,
  "New Jersey": 35, "New Mexico": 65, "New York": 35, "North Carolina": 65,
  "North Dakota": 22, Ohio: 35, Oklahoma: 65, Oregon: 50, Pennsylvania: 35,
  "Puerto Rico": 80, "Rhode Island": 35, "South Carolina": 65,
  "South Dakota": 22, Tennessee: 65, Texas: 80, Utah: 35, Vermont: 22,
  Virginia: 50, Washington: 50, "West Virginia": 50, Wisconsin: 22, Wyoming: 22,
};
const ESC_TIER: Record<string, number> = {
  California: 1, Hawaii: 1, Massachusetts: 1, "New York": 1, "New Jersey": 1,
  Connecticut: 1, Maryland: 2, "District of Columbia": 2, Illinois: 2,
  Pennsylvania: 2, Texas: 2, Virginia: 2, "Rhode Island": 2,
  "New Hampshire": 2, Maine: 2, Delaware: 2, Vermont: 2, Washington: 4,
  Idaho: 4, Montana: 4, "North Dakota": 4, "South Dakota": 4, Nebraska: 4,
  Wyoming: 4, "Puerto Rico": 5,
};
const BANDS: Record<number, { range: string; rate: number }> = {
  1: { range: "4–6%", rate: 0.045 },
  2: { range: "3–4%", rate: 0.035 },
  3: { range: "2–3%", rate: 0.025 },
  4: { range: "1–2%", rate: 0.018 },
  5: { range: "volatile", rate: 0.025 },
};
const states = Object.keys(STATE_COOL).map((name) => {
  const tier = ESC_TIER[name] || 3;
  return { name, cool: STATE_COOL[name], rate: BANDS[tier].rate, range: BANDS[tier].range };
});
const counts = [
  { mult: 1, label: "Just one for now", short: "1 property" },
  { mult: 3, label: "2 to 4", short: "~3 properties" },
  { mult: 7, label: "5 to 9", short: "~7 properties" },
  { mult: 15, label: "10 to 19", short: "~15 properties" },
  { mult: 25, label: "20+", short: "20+ properties" },
];
---

<section class="section est" id="calculator" aria-labelledby="est-title">
  <div class="container">
    <div class="est__head reveal">
      <h2 class="est__title" id="est-title">Now run your own number.</h2>
      <p class="est__lede lede">
        Three inputs. The output is the conservative floor for your property,
        and the real number is measured at your meter during the pilot, on our
        dime.
      </p>
    </div>

    <form class="est__form reveal" id="est-form" style="--i: 1">
      <div class="est__control">
        <div class="est__row">
          <label for="est-spend">Annual electricity spend, per property</label>
          <output id="est-spend-out" for="est-spend">$400,000</output>
        </div>
        <input type="range" id="est-spend" min="60000" max="5000000" step="5000" value="400000" />
        <div class="est__scale" aria-hidden="true"><span>$60k</span><span>$5M</span></div>
        <p class="est__hint" id="est-monthly">about $33,333 per month, electricity only, not total energy</p>
      </div>

      <div class="est__control">
        <span class="est__legend" id="est-count-legend">How many hotels do you operate?</span>
        <div class="est__chips" role="radiogroup" aria-labelledby="est-count-legend">
          {
            counts.map((c, i) => (
              <label class="est__chip">
                <input type="radio" name="est-count" value={c.mult} data-short={c.short} checked={i === 0} />
                <span>{c.label}</span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="est__control">
        <label for="est-state">Primary state</label>
        <div class="est__sel">
          <select id="est-state" required>
            <option value="" disabled selected>Choose your state</option>
            {
              states.map((s) => (
                <option value={s.name} data-cool={s.cool} data-rate={s.rate} data-range={s.range}>
                  {s.name}
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <button type="submit" class="btn est__go" id="est-go" disabled>
        Calculate my savings
        <span class="btn__arrow" aria-hidden="true">&rarr;</span>
      </button>
    </form>

    <div class="est__results" id="est-results" hidden>
      <div class="est__streams" aria-live="polite">
        <div class="est__stream">
          <span class="est__stream-label">Harmonization, verified floor</span>
          <span class="est__stream-val" id="est-harmo">$0</span>
          <span class="est__stream-note">8% of spend, the number we guarantee against</span>
        </div>
        <div class="est__stream">
          <span class="est__stream-label">Cooling optimization</span>
          <span class="est__stream-val" id="est-cool">$0</span>
          <span class="est__stream-note" id="est-cool-note">15–55% of your cooling spend</span>
        </div>
        <div class="est__stream">
          <span class="est__stream-label">Demand response</span>
          <span class="est__stream-val" id="est-dem">$0</span>
          <span class="est__stream-note">demand charges most vendors never touch</span>
        </div>
        <div class="est__stream">
          <span class="est__stream-label">Outdoor lighting</span>
          <span class="est__stream-val" id="est-lit">$0</span>
          <span class="est__stream-note">parking, facade, and grounds circuits</span>
        </div>
      </div>

      <div class="est__total">
        <span class="est__total-label">Conservative annual floor, per property</span>
        <span class="est__total-val" id="est-floor">$0</span>
        <span class="est__total-range" id="est-range"></span>
        <p class="est__portfolio" id="est-portfolio" hidden></p>
      </div>

      <div class="est__facts">
        <div class="est__fact">
          <h3 class="est__fact-title" id="est-state-title">Your state</h3>
          <p class="est__fact-body" id="est-state-body"></p>
        </div>
        <div class="est__fact">
          <h3 class="est__fact-title">Your equipment, meanwhile</h3>
          <p class="est__fact-body">
            Every month at the current power quality, the distortion keeps
            working on the loads above: the PTAC fleet, the elevator motors,
            the pumps. The bill is the floor; <a href="#what-we-find">the
            equipment is the other half of the story</a>.
          </p>
        </div>
        <div class="est__fact">
          <h3 class="est__fact-title">Section 179D deduction</h3>
          <p class="est__fact-body" id="est-ded-body"></p>
        </div>
      </div>

      <div class="est__cta">
        <p class="est__cta-line">
          That number is a model. The pilot replaces it with a measurement, at
          your meter, before you commit a dollar.
        </p>
        <a href="#book" class="btn">
          Verify this at my property
          <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
        <p class="est__disclaimer">
          Directional estimate using the conservative floor rates from
          measured installs, applied to your electricity spend. Not a quote.
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const form = document.getElementById("est-form");
    if (!form) return;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => "$" + Math.round(n).toLocaleString("en-US");
    const fmtRange = (a, b) => fmt(a) + " – " + fmt(b);

    const spendEl = $("est-spend");
    const stateEl = $("est-state");
    const go = $("est-go");
    const results = $("est-results");

    const syncSpend = () => {
      const v = Number(spendEl.value);
      $("est-spend-out").textContent = fmt(v);
      $("est-monthly").textContent =
        "about " + fmt(v / 12) + " per month, electricity only, not total energy";
    };
    const ready = () => {
      const ok = !!stateEl.value;
      go.disabled = !ok;
      go.style.opacity = ok ? "1" : "0.45";
    };
    spendEl.addEventListener("input", syncSpend);
    stateEl.addEventListener("change", ready);
    syncSpend();
    ready();

    // count-up that always lands exactly on the target. The final value is
    // written first, so even if rAF never fires (throttled tab, odd engine)
    // the correct number is on screen; the animation is pure enhancement.
    const countUp = (el, target, suffixFn) => {
      const text = suffixFn || fmt;
      el.textContent = text(target);
      if (reduce) return;
      const t0 = performance.now();
      const dur = 900;
      const step = (now) => {
        const p = Math.min((now - t0) / dur, 1);
        const e = 1 - Math.pow(1 - p, 4);
        el.textContent = text(target * e);
        if (p < 1) requestAnimationFrame(step);
        else el.textContent = text(target);
      };
      requestAnimationFrame(step);
    };

    form.addEventListener("submit", (ev) => {
      ev.preventDefault();
      const spend = Number(spendEl.value);
      const opt = stateEl.options[stateEl.selectedIndex];
      const cool = Number(opt.getAttribute("data-cool")) / 100;
      const rate = Number(opt.getAttribute("data-rate"));
      const range = opt.getAttribute("data-range");
      const countInput = form.querySelector('input[name="est-count"]:checked');
      const mult = Number(countInput.value);
      const short = countInput.getAttribute("data-short");

      // ported hotel math (parity with the verified estimator)
      const HVAC_SHARE = 0.45, HARMO = 0.08;
      const COOL_FLOOR = 0.15, COOL_CEIL = 0.55;
      const DEM = 0.05 * 0.40;
      const LIT_F = 0.04 * 0.88, LIT_C = 0.09 * 0.88;

      const C = HVAC_SHARE * spend * cool;
      const harmo = HARMO * spend;
      const coolF = COOL_FLOOR * C, coolC = COOL_CEIL * C;
      const dem = DEM * spend;
      const litF = LIT_F * spend, litC = LIT_C * spend;
      const floor = harmo + coolF + dem + litF;
      const ceil = harmo + coolC + dem + litC;

      results.hidden = false;
      countUp($("est-harmo"), harmo);
      countUp($("est-cool"), coolC, (v) => fmtRange((coolF / coolC) * v, v));
      countUp($("est-dem"), dem);
      countUp($("est-lit"), litC, (v) => fmtRange((litF / litC) * v, v));
      countUp($("est-floor"), floor);
      $("est-range").textContent =
        "likely range " + fmtRange(floor, ceil) + ", before incentives";
      $("est-cool-note").textContent =
        "15–55% of cooling spend; cooling is ~" +
        Math.round(cool * 100) + "% of HVAC in " + opt.value;

      const port = $("est-portfolio");
      if (mult > 1) {
        port.hidden = false;
        port.textContent =
          "Across " + short + " at similar spend, the floor compounds to roughly " +
          fmtRange(floor * mult, ceil * mult) + " a year.";
      } else {
        port.hidden = true;
      }

      // state trajectory: documented escalation band projected over 10 years
      const future = spend * Math.pow(1 + rate, 10);
      let cum = 0;
      for (let n = 1; n <= 10; n++) cum += spend * (Math.pow(1 + rate, n) - 1);
      $("est-state-title").textContent = opt.value;
      $("est-state-body").textContent =
        "Commercial rates in " + opt.value + " have been rising " +
        (range === "volatile" ? "on a volatile trajectory (we project a conservative 2.5% floor)" : range + " a year") +
        ". Hold course and today's " + fmt(spend) + " bill runs about " + fmt(future) +
        " in year ten, roughly " + fmt(cum) + " in cumulative increases you absorb by waiting.";

      // Section 179D: estimated sqft from spend, $5.94/sqft, 21% tax value
      const sqftRaw = spend / 3.5;
      const sqft = sqftRaw >= 10000 ? Math.round(sqftRaw / 1000) * 1000 : Math.round(sqftRaw / 500) * 500;
      const ded = sqft * 5.94;
      $("est-ded-body").textContent =
        "A property this size runs roughly " + sqft.toLocaleString("en-US") +
        " sq ft. Efficiency work at this scale can qualify for a federal deduction up to " +
        fmt(ded) + " (about " + fmt(ded * 0.21) +
        " at a 21% rate). Most operators have never claimed it. We confirm eligibility during the pilot.";

      results.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
    });
  })();
</script>

<style>
  .est {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(
        ellipse 60% 45% at 50% 0%,
        rgba(194, 163, 104, 0.06),
        transparent 70%
      ),
      var(--bg);
  }
  .est__head {
    max-width: 54rem;
  }
  .est__title {
    font-size: var(--step-3);
    max-width: 18ch;
  }
  .est__lede {
    margin-top: var(--space-m);
  }

  .est__form {
    margin-top: var(--space-xl);
    display: grid;
    gap: var(--space-l);
    max-width: 46rem;
  }
  .est__control {
    display: grid;
    gap: 0.7rem;
  }
  .est__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
  }
  .est__control label,
  .est__legend {
    font-size: var(--step-0);
    color: var(--ink);
    font-weight: 500;
  }
  .est__row output {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--gold-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .est__scale {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }
  .est__hint {
    font-size: var(--step--1);
    color: var(--muted);
  }

  input[type="range"]#est-spend {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    border-radius: 999px;
    background: rgba(226, 216, 196, 0.16);
    outline-offset: 6px;
  }
  #est-spend::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--gold);
    border: 3px solid var(--surface);
    box-shadow: 0 0 0 1px var(--gold), 0 4px 12px -2px var(--gold-glow);
    cursor: pointer;
  }
  #est-spend::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--gold);
    border: 3px solid var(--surface);
    box-shadow: 0 0 0 1px var(--gold);
    cursor: pointer;
  }

  .est__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .est__chip {
    position: relative;
  }
  .est__chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .est__chip span {
    display: inline-block;
    padding: 0.6em 1.1em;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: var(--step--1);
    color: var(--body);
    transition: all 0.22s ease;
  }
  .est__chip input:checked + span {
    background: rgba(194, 163, 104, 0.16);
    border-color: var(--gold);
    color: var(--gold-text);
    font-weight: 600;
  }
  .est__chip input:focus-visible + span {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .est__sel {
    position: relative;
    max-width: 24rem;
  }
  .est__sel select {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-s);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--step-0);
    padding: 0.85em 2.6em 0.85em 1em;
    cursor: pointer;
  }
  .est__sel::after {
    content: "";
    position: absolute;
    right: 1.1em;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 1.5px solid var(--gold-text);
    border-bottom: 1.5px solid var(--gold-text);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  .est__sel select:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .est__go {
    justify-self: start;
    transition: opacity 0.25s ease, transform 0.4s var(--ease-out-quart), box-shadow 0.4s var(--ease-out-quart);
  }
  .est__go:disabled {
    cursor: not-allowed;
  }

  /* results: page sections, not a card */
  .est__results {
    margin-top: var(--space-2xl);
  }
  .est__streams {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }
  .est__stream {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: var(--space-m);
    border-top: 1px solid var(--line-strong);
  }
  .est__stream-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .est__stream-val {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    color: var(--gold-text);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .est__stream-note {
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 30ch;
  }

  .est__total {
    margin-top: var(--space-xl);
    padding-top: var(--space-l);
    border-top: 2px solid var(--gold-soft);
  }
  .est__total-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .est__total-val {
    display: block;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 5rem);
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    margin-block: 0.15em 0.1em;
  }
  .est__total-range {
    font-size: var(--step-0);
    color: var(--body);
  }
  .est__portfolio {
    margin-top: var(--space-m);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--gold-text);
    max-width: 50ch;
  }

  .est__facts {
    margin-top: var(--space-xl);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .est__fact-title {
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }
  .est__fact-body {
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--body);
  }
  .est__fact-body a {
    color: var(--gold-text);
  }

  .est__cta {
    margin-top: var(--space-xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }
  .est__cta-line {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--ink);
    max-width: 46ch;
  }
  .est__disclaimer {
    font-size: 0.74rem;
    color: var(--muted);
    max-width: 60ch;
  }
</style>
