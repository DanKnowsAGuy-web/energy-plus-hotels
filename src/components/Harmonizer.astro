---
// "The healing of a hotel" — merged scroll scene, v3.
// Grid power stays dirty the entire time: distortion is what the utility
// delivers. The harmonizer sits pressed against the building like a shield,
// and only what's behind it transforms. The circular device on the ground
// floor IS the kWh meter (reading beside it falls 14,555 -> 9,000); the
// pool/laundry drive drum sits just left of the elevator shaft. Sparks ride
// the riser while dirty; clean blue sine waves feed every line once healed.
const X0 = 80;
const WAVE_END = 418; // reaches the building until the shield clips it back
const DRAW_W = (WAVE_END - X0) * 2;
const midY = 280;
const amp = 22;
const N = 240;

function wave() {
  const cycles = 7;
  let d = "";
  for (let i = 0; i <= N; i++) {
    const x = X0 + (i / N) * DRAW_W;
    const t = (i / N) * Math.PI * 2 * cycles;
    const y = midY - amp * (0.6 * Math.sin(t) + 0.26 * Math.sin(3 * t + 0.6) + 0.2 * Math.sin(5 * t + 1.2));
    d += (i === 0 ? "M" : "L") + x.toFixed(1) + " " + y.toFixed(1) + " ";
  }
  return d.trim();
}
const distD = wave();

function mini(x1: number, x2: number, y: number) {
  const n = Math.max(16, Math.round((x2 - x1) / 6));
  const cycles = (x2 - x1) / 26;
  let d = "";
  for (let i = 0; i <= n; i++) {
    const x = x1 + (i / n) * (x2 - x1);
    const yy = y - 3.5 * Math.sin((i / n) * Math.PI * 2 * cycles);
    d += (i === 0 ? "M" : "L") + x.toFixed(1) + " " + yy.toFixed(1) + " ";
  }
  return d.trim();
}

const winRows = [270, 230, 190, 150, 110];
const winCols = [436, 468, 500, 532, 564];
const ptacs = [244, 204, 164];
---

<section class="hz" aria-labelledby="hz-title">
  <div class="hz__sticky">
    <div class="container hz__inner">
      <div class="hz__head">
        <h2 class="hz__title" id="hz-title">
          What dirty power does, and what the harmonizer undoes.
        </h2>
        <p class="hz__caption" id="hz-caption" aria-live="polite">
          Distortion comes in with the power itself. Watch it enter the
          service entrance and climb into everything you own.
        </p>
      </div>

      <figure class="hz__figure">
        <svg
          class="hz__svg"
          viewBox="0 0 760 360"
          role="img"
          aria-label="Distorted grid current flows toward a hotel cross-section, running its meter, laundry and pool drives, PTAC units, and elevator motor hot; a harmonizer drops in against the building like a shield, and everything behind it heals: clean blue current feeds every line, the meter falls from 14,555 to 9,000 kilowatt-hours, and the guest windows warm as the building settles. The grid side stays distorted throughout."
        >
          <defs>
            <clipPath id="hz-clip-dist">
              <rect id="hz-rect-d" x="80" y="250" width="338" height="62"></rect>
            </clipPath>
          </defs>

          <line class="hz__ground" x1="80" y1="330" x2="752" y2="330"></line>
          <text class="hz__tag" x="80" y="240">Grid power, distorted</text>

          <!-- the line: the grid side never cleans up -->
          <line class="hz__axis" x1="80" y1={midY} x2="420" y2={midY}></line>
          <g clip-path="url(#hz-clip-dist)">
            <path class="hz__wave hz__wave--dist hz__flow" d={distD}></path>
          </g>

          <!-- building shell -->
          <g class="hz__bld" id="hz-bld">
            <rect class="hz__shell" id="hz-shell" x="420" y="40" width="240" height="290" rx="3"></rect>
            <rect class="hz__shell" x="510" y="20" width="56" height="20" rx="3"></rect>
            {[100, 140, 180, 220, 260, 300].map((y) => (
              <line class="hz__floor" x1="420" y1={y} x2="660" y2={y}></line>
            ))}
            <rect class="hz__shaft" x="614" y="100" width="36" height="230"></rect>

            {winRows.map((y, ri) => (
              <g class="hz__winrow" id={`hz-w${ri}`}>
                {winCols.map((x) => (
                  <rect class="hz__win" x={x} y={y} width="20" height="12" rx="1.5"></rect>
                ))}
              </g>
            ))}

            <!-- riser: red infection + mint healing overlay -->
            <path class="hz__riser hz__riser--red" id="hz-riser-red" d="M424 280 L424 64"></path>
            <path class="hz__riser hz__riser--mint" id="hz-riser-mint" d="M424 280 L424 64"></path>
            <path class="hz__riser hz__riser--red" id="hz-drop-red" d="M424 280 L424 312"></path>
            <path class="hz__riser hz__riser--mint" id="hz-drop-mint" d="M424 280 L424 312"></path>

            <!-- ground floor: the kWh meter (the circle) + reading beside it,
                 then the pool/laundry drive drum left of the shaft -->
            <g class="hz__load" id="hz-base">
              <line class="hz__stub" x1="424" y1="312" x2="446" y2="312"></line>
              <path class="hz__mini" d={mini(426, 444, 312)}></path>
              <circle class="hz__load-ln hz__meter-face" cx="455" cy="312" r="10"></circle>
              <line class="hz__load-ln" x1="455" y1="312" x2="461" y2="306"></line>
            </g>
            <text class="hz__kwh-read" id="hz-kwh" x="472" y="318">14,555</text>
            <text class="hz__dev-label" x="473" y="329">kWh meter</text>

            <!-- PTAC fleet -->
            {ptacs.map((y, i) => (
              <g class="hz__load" id={`hz-ptac${i}`}>
                <line class="hz__stub" x1="424" y1={y + 6} x2="582" y2={y + 6}></line>
                <path class="hz__mini" d={mini(428, 580, y + 6)}></path>
                <rect class="hz__load-ln" x="584" y={y} width="22" height="12" rx="2"></rect>
                <line class="hz__load-ln" x1="588" y1={y + 4} x2="598" y2={y + 4}></line>
                <circle class="hz__load-ln" cx="601" cy={y + 8} r="2.4"></circle>
                {i === 0 && (
                  <>
                    <line class="hz__stub" x1="593" y1={y + 12} x2="593" y2="298"></line>
                    <rect class="hz__load-ln" x="578" y="298" width="30" height="28" rx="3"></rect>
                    <circle class="hz__load-ln" cx="593" cy="312" r="8"></circle>
                    <circle class="hz__load-ln" cx="593" cy="312" r="3"></circle>
                  </>
                )}
              </g>
            ))}

            <!-- elevator: traction motor + cab with up/down arrows -->
            <g class="hz__load" id="hz-elev">
              <line class="hz__stub" x1="424" y1="84" x2="614" y2="84"></line>
              <path class="hz__mini" d={mini(428, 612, 84)}></path>
              <rect class="hz__load-ln" x="616" y="72" width="32" height="24" rx="3"></rect>
              <circle class="hz__load-ln" cx="632" cy="84" r="5"></circle>
              <rect class="hz__load-ln" x="621" y="196" width="22" height="28" rx="2"></rect>
              <path class="hz__load-ln" d="M626 176 l6 -9 6 9"></path>
              <path class="hz__load-ln" d="M626 240 l6 9 6 -9"></path>
            </g>

            <!-- sparks riding the riser while the building is dirty -->
            <circle class="hz__spark" id="hz-spark1" r="2.6"></circle>
            <circle class="hz__spark" id="hz-spark2" r="2"></circle>
            <circle class="hz__spark" id="hz-spark3" r="2.3"></circle>
            <circle class="hz__spark" id="hz-spark4" r="1.7"></circle>
          </g>

          <!-- device labels, right column -->
          <g class="hz__labels">
            <line class="hz__leader" x1="652" y1="84" x2="664" y2="84"></line>
            <text class="hz__dev-label" x="668" y="88">Elevator motor</text>
            <line class="hz__leader" x1="608" y1="210" x2="664" y2="210"></line>
            <text class="hz__dev-label" x="668" y="214">PTAC fleet</text>
            <line class="hz__leader" x1="610" y1="312" x2="664" y2="312"></line>
            <text class="hz__dev-label" x="668" y="310">Pool &amp; spa pumps,</text>
            <text class="hz__dev-label" x="668" y="322">laundry drives</text>
          </g>

          <!-- harmonizer: the shield, pressed against the building -->
          <g class="hz__box" id="hz-box" transform="translate(0,-230)">
            <rect class="hz__box-body" x="326" y="232" width="92" height="96" rx="7"></rect>
            <line class="hz__box-line" x1="342" y1="258" x2="402" y2="258"></line>
            <line class="hz__box-line" x1="342" y1="272" x2="402" y2="272"></line>
            <line class="hz__box-line" x1="342" y1="286" x2="402" y2="286"></line>
            <text class="hz__box-label" x="372" y="314" text-anchor="middle">Harmonizer</text>
          </g>

          <g class="hz__meter" transform="translate(80,110)">
            <text class="hz__meter-label" x="0" y="0">Power factor</text>
            <text class="hz__meter-val" id="hz-pf" x="0" y="34">0.82</text>
            <g class="hz__stamp">
              <rect x="78" y="10" width="84" height="26" rx="3"></rect>
              <text x="120" y="28" text-anchor="middle">VERIFIED</text>
            </g>
          </g>
        </svg>
      </figure>

      <div class="hz__progress" aria-hidden="true">
        <span class="hz__progress-fill" id="hz-progress"></span>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const sec = document.querySelector(".hz");
    if (!sec) return;
    const $ = (id) => document.getElementById(id);
    const caption = $("hz-caption");
    const box = $("hz-box");
    const pf = $("hz-pf");
    const kwh = $("hz-kwh");
    const prog = $("hz-progress");
    const riserRed = $("hz-riser-red");
    const riserMint = $("hz-riser-mint");
    const dropRed = $("hz-drop-red");
    const dropMint = $("hz-drop-mint");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const RISER = 216, DROP = 32;
    const KWH_HI = 14555, KWH_LO = 9000;
    [ [riserRed, RISER], [riserMint, RISER], [dropRed, DROP], [dropMint, DROP] ]
      .forEach(([el, len]) => {
        el.style.strokeDasharray = len;
        el.style.strokeDashoffset = len;
      });

    // choreography completes by ~p 0.75; the rest of the track is a hold
    // beat so the finished building gets a full scroll of quiet
    const loads = [
      { el: $("hz-base"), hot: 0.045, cool: 0.48 },
      { el: $("hz-ptac0"), hot: 0.08, cool: 0.53 },
      { el: $("hz-ptac1"), hot: 0.11, cool: 0.58 },
      { el: $("hz-ptac2"), hot: 0.14, cool: 0.63 },
      { el: $("hz-elev"), hot: 0.17, cool: 0.67 },
    ];
    const winRows = [0, 1, 2, 3, 4].map((i) => ({
      el: $("hz-w" + i), at: 0.68 + i * 0.016,
    }));

    const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
    const smooth = (p, a, b) => {
      const t = clamp((p - a) / (b - a), 0, 1);
      return t * t * (3 - 2 * t);
    };
    const fmtK = (n) => Math.round(n).toLocaleString("en-US");
    const rectD = $("hz-rect-d");

    const captions = [
      "Distortion comes in with the power itself. It climbs from the service entrance into everything you own, and the meter on the ground floor bills all of it: 14,555 kWh.",
      "The harmonizer drops in against the building, a shield between the grid and everything behind it.",
      "The grid stays dirty; that's not yours to fix. Behind the shield, clean current feeds every line, the equipment cools floor by floor, and the meter falls.",
      "The building runs as one system. 14,555 becomes 9,000 at the meter, and your guests never felt a thing.",
    ];
    let lastPhase = -1;
    let infectNow = 0, climbNow = 0;

    const apply = (p) => {
      const infect = smooth(p, 0, 0.18);
      const drop = smooth(p, 0.2, 0.33);
      const climb = smooth(p, 0.38, 0.66);
      infectNow = infect; climbNow = climb;

      riserRed.style.strokeDashoffset = (RISER * (1 - infect)).toFixed(1);
      dropRed.style.strokeDashoffset = (DROP * (1 - Math.min(infect * 3, 1))).toFixed(1);
      riserMint.style.strokeDashoffset = (RISER * (1 - climb)).toFixed(1);
      dropMint.style.strokeDashoffset = (DROP * (1 - Math.min(climb * 4, 1))).toFixed(1);

      box.setAttribute("transform", "translate(0," + (-230 * (1 - drop)).toFixed(1) + ")");
      box.style.opacity = (0.15 + 0.85 * drop).toFixed(2);

      // the dirty wave reaches the building until the shield seats, then is
      // clipped back to the shield's left edge (no dead gap on the line)
      rectD.setAttribute("width", (418 - 92 * drop - 80).toFixed(1));

      loads.forEach((l) => {
        const cooled = p >= l.cool;
        l.el.classList.toggle("is-hot", p > l.hot && !cooled);
        l.el.classList.toggle("is-cool", cooled);
      });
      winRows.forEach((w) => w.el.classList.toggle("is-warm", p > w.at));

      kwh.textContent = fmtK(KWH_HI - (KWH_HI - KWH_LO) * climb);
      kwh.classList.toggle("is-good", climb > 0.6);

      const pfVal = 0.82 + (Math.round(climb * 5) / 5) * 0.15;
      pf.textContent = pfVal.toFixed(2);
      pf.classList.toggle("is-good", p > 0.72);
      sec.classList.toggle("is-stamped", p > 0.72);
      sec.classList.toggle("is-settled", p > 0.75);
      if (prog) prog.style.transform = "scaleX(" + p.toFixed(3) + ")";

      const phase = p < 0.22 ? 0 : p < 0.38 ? 1 : p < 0.68 ? 2 : 3;
      if (phase !== lastPhase && caption) {
        caption.textContent = captions[phase];
        lastPhase = phase;
      }
    };

    if (reduce) {
      sec.classList.add("is-static", "is-stamped", "is-settled");
      box.setAttribute("transform", "translate(0,0)");
      box.style.opacity = "1";
      [riserRed, dropRed, riserMint, dropMint].forEach((el) => (el.style.strokeDashoffset = 0));
      rectD.setAttribute("width", "246");
      loads.forEach((l) => l.el.classList.add("is-cool"));
      winRows.forEach((w) => w.el.classList.add("is-warm"));
      pf.textContent = "0.97";
      pf.classList.add("is-good");
      kwh.textContent = fmtK(KWH_LO);
      kwh.classList.add("is-good");
      caption.textContent = captions[3];
      return;
    }

    try {
      const sparks = [
        { el: $("hz-spark1"), dur: 2600, off: 0 },
        { el: $("hz-spark2"), dur: 3900, off: 0.5 },
        { el: $("hz-spark3"), dur: 3100, off: 0.25 },
        { el: $("hz-spark4"), dur: 4500, off: 0.75 },
      ].filter((s) => s.el);
      const len = riserRed.getTotalLength();
      if (len > 0) {
        const t0 = performance.now();
        const loop = (now) => {
          const vis = infectNow * (1 - climbNow);
          for (const s of sparks) {
            const t = (((now - t0) / s.dur) + s.off) % 1;
            // travel UP the riser, toward the devices, as far as the
            // infection has reached
            const pt = riserRed.getPointAtLength(t * infectNow * len);
            s.el.setAttribute("cx", pt.x.toFixed(1));
            s.el.setAttribute("cy", pt.y.toFixed(1));
            s.el.style.opacity = (vis * (0.55 + 0.45 * Math.sin(now / 130 + s.off * 7))).toFixed(2);
          }
          requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);
      }
    } catch (e) { /* decoration only */ }

    let ticking = false;
    const onScroll = () => {
      const total = sec.offsetHeight - window.innerHeight;
      const p = clamp(-sec.getBoundingClientRect().top / total, 0, 1);
      apply(p);
      ticking = false;
    };
    addEventListener("scroll", () => {
      if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
    }, { passive: true });
    addEventListener("resize", onScroll, { passive: true });
    apply(0);
  })();
</script>

<style>
  /* extra track length = the hold beat at the finished state */
  .hz { position: relative; height: 480vh; border-top: 1px solid var(--line); }
  .hz__sticky {
    position: sticky; top: 0; height: 100vh;
    display: flex; align-items: center; overflow: hidden;
  }
  .hz__inner { width: 100%; }
  .hz__head { max-width: 60rem; margin-bottom: clamp(1rem, 3vh, 2.5rem); }
  .hz__title { font-size: var(--step-3); max-width: 20ch; }
  .hz__caption {
    margin-top: var(--space-m); font-size: var(--step-1); line-height: 1.5;
    color: var(--body); max-width: 58ch; min-height: 3em;
  }

  .hz__figure { margin: 0; }
  .hz__svg { width: 100%; height: auto; max-height: 56vh; }

  .hz__ground { stroke: var(--line-strong); stroke-width: 1.5; stroke-dasharray: 5 6; }
  .hz__axis { stroke: var(--line); stroke-width: 1; stroke-dasharray: 3 6; }
  .hz__wave { fill: none; stroke-width: 2.6; vector-effect: non-scaling-stroke; }
  .hz__wave--dist { stroke: #e05a2b; filter: drop-shadow(0 0 5px rgba(224, 90, 43, 0.4)); }
  @media (prefers-reduced-motion: no-preference) {
    .hz__flow { animation: hzFlow 6.5s linear infinite; }
    @keyframes hzFlow {
      from { transform: translateX(-50%); }
      to { transform: translateX(0); }
    }
  }

  .hz__tag { font-family: var(--font-mono); font-size: 12px; fill: var(--muted); }
  .hz__dev-label { font-family: var(--font-mono); font-size: 10px; fill: var(--muted); }
  .hz__leader { stroke: var(--line); stroke-width: 0.7; stroke-dasharray: 2 3; }

  .hz__kwh-read {
    font-family: var(--font-mono); font-size: 26px; font-weight: 500;
    fill: #e05a2b; transition: fill 0.5s ease;
    font-variant-numeric: tabular-nums;
  }
  .hz__kwh-read.is-good { fill: var(--mint); }
  .hz__meter-face { fill: #0c211b; }

  /* building */
  .hz__shell {
    fill: rgba(255, 255, 255, 0.02); stroke: var(--line-strong); stroke-width: 1.5;
    transition: stroke 0.7s ease, filter 0.7s ease;
  }
  .hz.is-settled .hz__shell {
    stroke: var(--mint);
    filter: drop-shadow(0 0 8px rgba(91, 194, 162, 0.3));
  }
  .hz__floor { stroke: var(--line); stroke-width: 1; }
  .hz__shaft { fill: rgba(226, 216, 196, 0.04); stroke: var(--line); stroke-width: 1; }
  .hz__win {
    fill: rgba(226, 216, 196, 0.07); stroke: var(--line); stroke-width: 0.6;
    transition: fill 0.6s ease, stroke 0.6s ease, filter 0.6s ease;
  }
  .hz__winrow.is-warm .hz__win {
    fill: rgba(216, 190, 134, 0.55); stroke: var(--gold-text);
    filter: drop-shadow(0 0 4px rgba(216, 190, 134, 0.4));
  }

  .hz__riser { fill: none; stroke-width: 2.2; stroke-linecap: round; }
  .hz__riser--red { stroke: #e05a2b; filter: drop-shadow(0 0 4px rgba(224, 90, 43, 0.5)); }
  .hz__riser--mint { stroke: var(--mint); filter: drop-shadow(0 0 4px rgba(91, 194, 162, 0.5)); }

  .hz__spark {
    fill: #ff8a4d; opacity: 0;
    filter: drop-shadow(0 0 4px rgba(255, 138, 77, 0.9));
  }

  .hz__mini {
    fill: none; stroke: #5b9dc2; stroke-width: 1.6;
    stroke-dasharray: 14 10; opacity: 0;
    filter: drop-shadow(0 0 3px rgba(91, 157, 194, 0.5));
    transition: opacity 0.6s ease;
  }
  .hz__load.is-cool .hz__mini { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .hz__mini { animation: hzFeed 1.6s linear infinite; }
    @keyframes hzFeed {
      from { stroke-dashoffset: 0; }
      to { stroke-dashoffset: -48; }
    }
  }

  .hz__stub { stroke: var(--line-strong); stroke-width: 1.4; transition: stroke 0.5s ease; }
  .hz__load-ln {
    stroke: var(--muted); fill: none; stroke-width: 1.6; stroke-linecap: round;
    opacity: 0.7; transition: stroke 0.5s ease, opacity 0.5s ease;
  }
  .hz__load.is-hot .hz__stub,
  .hz__load.is-hot .hz__load-ln {
    stroke: #e05a2b; opacity: 1;
    filter: drop-shadow(0 0 5px rgba(224, 90, 43, 0.55));
  }
  .hz__load.is-cool .hz__stub,
  .hz__load.is-cool .hz__load-ln {
    stroke: #5b9dc2; opacity: 1;
    filter: drop-shadow(0 0 4px rgba(91, 157, 194, 0.45));
  }
  @media (prefers-reduced-motion: no-preference) {
    .hz__load.is-hot { animation: hzShake 0.34s ease-in-out infinite; }
    @keyframes hzShake {
      0%, 100% { transform: translate(0, 0); }
      25% { transform: translate(1px, -0.6px); }
      75% { transform: translate(-1px, 0.6px); }
    }
    /* overheating: the machine outlines themselves pulse with heat */
    .hz__load.is-hot .hz__load-ln {
      animation: hzOverheat 1.1s ease-in-out infinite;
    }
    @keyframes hzOverheat {
      0%, 100% {
        filter: drop-shadow(0 0 3px rgba(224, 90, 43, 0.45));
        stroke-width: 1.6;
      }
      50% {
        filter: drop-shadow(0 0 8px rgba(224, 90, 43, 0.85));
        stroke-width: 2;
      }
    }
  }

  .hz__box-body { fill: var(--surface-2); stroke: var(--gold); stroke-width: 1.6; }
  .hz__box-line { stroke: var(--gold-text); stroke-width: 1.6; }
  .hz__box-label {
    font-family: var(--font-mono); font-size: 11px;
    fill: var(--gold-text); letter-spacing: 0.02em;
  }

  .hz__meter-label {
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.08em; text-transform: uppercase; fill: var(--muted);
  }
  .hz__meter-val {
    font-family: var(--font-serif); font-size: 30px;
    fill: #e05a2b; transition: fill 0.5s ease;
  }
  .hz__meter-val.is-good { fill: var(--mint); }

  .hz__stamp {
    opacity: 0; transform-box: fill-box; transform-origin: center;
    transform: scale(1.6) rotate(-7deg);
    transition: opacity 0.35s ease, transform 0.45s var(--ease-out-quart);
