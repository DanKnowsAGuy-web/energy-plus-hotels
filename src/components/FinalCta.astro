<section class="section final" id="book" aria-labelledby="final-title">
  <div class="container">
    <div class="final__inner reveal">
      <h2 class="final__title" id="final-title">
        Stop being sold around. Get the building diagnosed.
      </h2>
      <p class="final__lede">
        Thirty minutes. We look at your portfolio, tell you whether a pilot
        makes sense, and explain exactly how we'd diagnose and verify the floor
        at your building. No projection, no pressure, and the diagnosis is on
        us.
      </p>

      <div class="final__actions">
        <a href="#book" class="btn btn--lg">
          Book the conversation
          <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
        <!-- PLACEHOLDER: wire to real scheduling link / form -->
      </div>

      <p class="final__qualify">
        We take a limited number of buildings each quarter, because real
        diagnosis takes real attention. We'll tell you early if yours isn't a
        fit.
      </p>
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
    background: linear-gradient(
      200deg,
      var(--hero-to) 0%,
      var(--bg-header) 100%
    );
  }
  .final__inner {
    position: relative;
    max-width: 46rem;
  }
  .final__title {
    font-size: var(--step-4);
    max-width: 18ch;
  }
  .final__lede {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--body);
    max-width: 54ch;
  }
  .final__actions {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
  }
  .btn--lg {
    padding: 1.1em 1.9em;
    font-size: var(--step-1);
  }
  .final__qualify {
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 52ch;
  }
</style>
