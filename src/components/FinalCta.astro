---
import CtaPair from "./CtaPair.astro";
---

<section class="section final" id="book" aria-labelledby="final-title">
  <div class="container">
    <div class="final__inner reveal">
      <h2 class="final__title" id="final-title">
        Stop paying for power your hotel never uses.
      </h2>
      <p class="final__lede">
        Thirty minutes. We look at your portfolio, tell you whether a Verified
        Savings Pilot makes sense, and show you exactly how we'd diagnose and
        verify the floor at your building. No projection, no pressure.
      </p>

      <div class="final__actions">
        <CtaPair size="lg" />
        <span class="final__aside">We typically have a same-week slot.</span>
      </div>
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
    background: linear-gradient(
      200deg,
      var(--hero-to) 0%,
      var(--bg-header) 100%
    );
  }
  .final__inner {
    position: relative;
    max-width: 46rem;
  }
  .final__title {
    font-size: var(--step-4);
    max-width: 18ch;
  }
  .final__lede {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--body);
    max-width: 54ch;
  }
  .final__actions {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
  }
  .btn--lg {
    padding: 1.1em 1.9em;
    font-size: var(--step-1);
  }
  .final__aside {
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
