---
// CONCEPT B — "photographic + diagnostic overlay" hero. A real hotel image
// (placeholder Unsplash; swap for an owned shot) with a tech overlay: a teal
// scan line sweeping the building, pinned dollar callouts on the systems, and
// the red waste HUD. Instantly reads hotel/hospitality; the overlay carries
// the instrument story. Copy is identical to the other heroes.
const PHOTO =
  "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1700&q=70";
const pins = [
  { x: "72%", y: "26%", name: "Rooftop AHUs", cost: "+$920/mo" },
  { x: "84%", y: "54%", name: "Chiller plant", cost: "+$1,180/mo" },
  { x: "63%", y: "72%", name: "Empty rooms, still cooled", cost: "+$760/mo" },
];
---

<section class="hero photo" aria-labelledby="hero-title">
  <div class="photo__scene" aria-hidden="true">
    <img class="photo__img" src={PHOTO} alt="" loading="eager" decoding="async" />
    <div class="photo__tone"></div>
    <div class="photo__grid"></div>
    <div class="photo__scan"></div>

    {pins.map((p, i) => (
      <div class="photo__pin" style={`left:${p.x}; top:${p.y}; --pd:${0.6 + i * 0.45}s`}>
        <span class="photo__pin-dot"></span>
        <span class="photo__pin-card">
          <span class="photo__pin-name">{p.name}</span>
          <span class="photo__pin-cost">{p.cost}</span>
        </span>
      </div>
    ))}

    <div class="photo__scrim"></div>

    <div class="hero__hud" aria-hidden="true">
      <div class="hero__hud-total">
        <span class="hero__hud-label">Estimated waste found</span>
        <span class="hero__hud-val"><span data-hud-total>$0</span><span class="hero__hud-mo">/mo</span></span>
        <span class="hero__hud-note">illustrative, until we measure yours</span>
      </div>
    </div>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__kicker reveal">The smart operators don't guess. They measure.</p>
      <h1 class="hero__title reveal" id="hero-title">
        Your hotel is
        <span class="hero__title-accent">overpaying for energy.</span>
      </h1>
      <p class="hero__lede lede reveal">
        We find exactly how much and prove it at your own meter, so you can cut
        the bill without taking a vendor's word.
      </p>
      <div class="hero__actions reveal">
        <a href="#book" class="btn">
          Book your Verified Savings Pilot
          <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <ul class="hero__chips reveal" aria-label="What the pilot does not require">
        <li>No capital at risk</li>
        <li>No equipment torn out</li>
      </ul>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const el = document.querySelector(".photo [data-hud-total]");
    if (!el) return;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const target = 4510;
    const fmt = (n) => "$" + Math.round(n).toLocaleString("en-US");
    if (reduce || !("IntersectionObserver" in window)) { el.textContent = fmt(target); return; }
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const s = performance.now();
        const tick = (now) => {
          const t = Math.min((now - s) / 1400, 1);
          el.textContent = fmt(target * (1 - Math.pow(1 - t, 4)));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.5 });
    io.observe(el);
  })();
</script>

<style>
  .hero.photo {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: clamp(30rem, 80vh, 46rem);
    display: flex; align-items: center; background: #0e1216;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  .photo__scene { position: absolute; inset: 0; z-index: -1; }
  .photo__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% 50%; filter: saturate(0.85) brightness(0.62); }
  /* teal/slate tone wash so the photo joins the dark instrument palette */
  .photo__tone { position: absolute; inset: 0; background: color-mix(in srgb, var(--bg) 55%, transparent); mix-blend-mode: multiply; }
  .photo__grid {
    position: absolute; inset: 0; opacity: 0.18; pointer-events: none;
    background-image: linear-gradient(color-mix(in srgb, var(--h-teal,#4fc4cf) 40%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--h-teal,#4fc4cf) 40%, transparent) 1px, transparent 1px);
    background-size: 54px 54px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 40%); mask-image: linear-gradient(90deg, transparent, #000 40%);
  }
  .photo__scan {
    position: absolute; left: 0; right: 0; height: 2px; top: 0;
    background: color-mix(in srgb, var(--h-teal,#4fc4cf) 85%, transparent);
    box-shadow: 0 0 18px 2px color-mix(in srgb, var(--h-teal,#4fc4cf) 60%, transparent);
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: no-preference) {
    .photo__scan { animation: photoScan 6s ease-in-out infinite; }
    @keyframes photoScan { 0% { top: 4%; } 50% { top: 92%; } 100% { top: 4%; } }
  }

  .photo__pin { position: absolute; transform: translate(-50%, -50%); display: flex; align-items: center; gap: 0.5rem; pointer-events: none; }
  .photo__pin-dot {
    width: 11px; height: 11px; border-radius: 50%; flex: none;
    background: var(--cost, #c87a64);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--cost,#c87a64) 22%, transparent), 0 0 14px 2px color-mix(in srgb, var(--cost,#c87a64) 55%, transparent);
  }
  .photo__pin-card {
    display: grid; gap: 0.05rem; padding: 0.4rem 0.6rem; border-radius: var(--radius-s);
    border: 1px solid var(--line-strong); background: color-mix(in srgb, var(--bg) 80%, transparent);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); font-family: var(--font-mono); white-space: nowrap;
  }
  .photo__pin-name { font-size: 0.62rem; color: var(--ink); }
  .photo__pin-cost { font-size: var(--step--1); color: var(--cost, #c87a64); font-weight: 500; font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: no-preference) {
    .photo__pin { opacity: 0; animation: photoPin 0.5s var(--ease-out-quart) forwards; animation-delay: var(--pd, 0.6s); }
    @keyframes photoPin { from { opacity: 0; transform: translate(-50%, calc(-50% + 6px)); } to { opacity: 1; transform: translate(-50%, -50%); } }
  }

  .photo__scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(100deg, var(--bg) 0%, var(--bg) 26%, color-mix(in srgb, var(--bg) 72%, transparent) 46%, transparent 66%),
      linear-gradient(0deg, var(--bg) 0%, transparent 26%);
  }

  .hero__hud { position: absolute; z-index: 2; top: clamp(1rem,4vh,2.2rem); right: clamp(1rem,3vw,2.4rem); display: grid; justify-items: end; text-align: right; pointer-events: none; font-family: var(--font-mono); }
  .hero__hud-total {
    display: grid; gap: 0.12rem; justify-items: end; padding: 0.6rem 0.85rem;
    border: 1px solid var(--line-strong); border-radius: var(--radius-s);
    background: color-mix(in srgb, var(--bg) 88%, transparent); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .hero__hud-label { font-size: 0.58rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .hero__hud-val { font-size: var(--step-2); color: var(--cost, #c87a64); font-variant-numeric: tabular-nums; line-height: 1; }
  .hero__hud-mo { font-size: 0.42em; color: var(--muted); margin-left: 0.15em; }
  .hero__hud-note { font-size: 0.56rem; color: var(--muted); }

  .hero__inner { position: relative; z-index: 5; width: 100%; }
  .hero__copy { max-width: 34rem; }
  .hero__kicker { font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.13em; text-transform: uppercase; color: var(--gold-text); margin-bottom: var(--space-m); }
  .hero__title { font-size: var(--step-5); line-height: 1.04; letter-spacing: -0.025em; max-width: 16ch; }
  .hero__title-accent { color: var(--body); font-style: italic; font-weight: 400; }
  .hero__lede { margin-top: var(--space-l); max-width: 50ch; }
  .hero__actions { margin-top: var(--space-l); display: flex; flex-wrap: wrap; gap: var(--space-s); }
  .hero__chips { margin-top: var(--space-m); padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; }
  .hero__chips li { display: inline-flex; align-items: center; gap: 0.5em; font-family: var(--font-mono); font-size: var(--step--1); color: var(--muted); }
  .hero__chips li::before { content: "\2713"; color: var(--mint); font-weight: 700; }

  @media (max-width: 52rem) {
    .hero.photo { min-height: auto; }
    .photo__img { object-position: 64% 50%; }
    .hero__title { font-size: var(--step-3); }
    .photo__pin-card { display: none; }
    .photo__pin-dot { width: 9px; height: 9px; }
    .hero__hud { top: auto; bottom: clamp(0.8rem,3vh,1.4rem); right: clamp(0.8rem,4vw,1.4rem); }
    .hero__chips li { background: color-mix(in srgb, var(--bg) 72%, transparent); border: 1px solid var(--line); border-radius: 999px; padding: 0.32em 0.7em; }
  }
</style>
