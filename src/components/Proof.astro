---
// Verified Tune case studies (from the published one-pagers). One canonical
// card format; 3 visible on desktop, 1 on mobile; infinite carousel.
// Figures shown floor-first, units always labeled (kWh vs kW matters).
// MOCK categories for layout testing only. Today every case below is a
// dirty-power (Tune) install; the cat labels/colors are placeholders to see how
// a three-category proof set (harmonization / HVAC / whole-building) would look.
const cats = {
  harm: { label: "Energy harmonization alone" },
  hvac: { label: "HVAC efficiency alone" },
  whole: { label: "Whole-building program" },
};
const cases = [
  {
    cat: "harm",
    type: "Hospitality",
    place: "Marietta, GA",
    name: "Hilton Garden Inn, Atlanta",
    figure: "13.51%", num: 13.51, dec: 2,
    unit: "kWh reduction at the meter, 12 months",
    scope: "123 rooms · 11 devices across 28 panels",
    verifier: "Verified by ABRAXAS",
  },
  {
    cat: "hvac",
    type: "Hotel & Resort",
    place: "Orange Beach, AL",
    name: "Caribe Resort",
    figure: "14%+", num: 14, suffix: "%+",
    unit: "kWh reduction, monthly average over 12 months",
    scope: "3 buildings · paid for itself in the first year",
    verifier: "Verified by CHI Energy",
  },
  {
    cat: "whole",
    type: "Hospitality",
    place: "Las Vegas, NV",
    name: "Southpoint Hotel & Casino",
    figure: "8.59%", num: 8.59, dec: 2,
    unit: "kW demand reduction, metered panels",
    scope: "arena lighting + receptacle panels, 45-day baseline",
    verifier: "Third-party meter data",
  },
  {
    cat: "harm",
    type: "Office + Warehouse",
    place: "Atlanta, GA",
    name: "Corey Center",
    figure: "14.8%", num: 14.8, dec: 1,
    unit: "kWh reduction, four-year average",
    scope: "35,000 sq ft · 8 devices, one per panel",
    verifier: "Verified by Noesis",
  },
  {
    cat: "hvac",
    type: "Office",
    place: "Birmingham, AL",
    name: "The Massey Building",
    figure: "9–19%",
    unit: "kWh reduction, metered floor by floor",
    scope: "10 floors · 10 devices, one per floor",
    verifier: "Metered impact evaluation",
  },
];
---

<section class="section proof" id="proof" aria-labelledby="proof-title">
  <div class="container">
    <div class="proof__head reveal">
      <h2 class="proof__title" id="proof-title">
        Proof, not promises.
      </h2>
      <p class="proof__lede lede">
        The scene above isn't hypothetical. Here is the distortion lever,
        measured in the field by independent analysts, floor numbers first.
      </p>
    </div>

    <div class="proof__carousel reveal" style="--i: 1">
      <button class="proof__arrow" id="proof-prev" type="button" aria-label="Previous case study">&larr;</button>
      <div class="proof__viewport" id="proof-viewport">
        <div class="proof__track" id="proof-track">
          {
            cases.map((c) => (
              <article class={`case case--${c.cat}`}>
                <p class="case__banner">{cats[c.cat].label}</p>
                <p class="case__type">{c.type}</p>
                <p class="case__place">{c.place}</p>
                <h3 class="case__name">{c.name}</h3>
                <p class="case__figure" data-countup={c.num} data-decimals={c.dec} data-suffix={c.suffix}>{c.figure}</p>
                <p class="case__unit">{c.unit}</p>
                <p class="case__scope">{c.scope}</p>
                <p class="case__verifier">{c.verifier}</p>
                <p class="case__chip">Tune&reg; · one technology in our stack</p>
              </article>
            ))
          }
        </div>
      </div>
      <button class="proof__arrow" id="proof-next" type="button" aria-label="Next case study">&rarr;</button>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const track = document.getElementById("proof-track");
    if (!track) return;
    const viewport = document.getElementById("proof-viewport");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const originals = Array.from(track.children);
    const n = originals.length;
    // clone both ends so the loop is seamless
    originals.forEach((c) => track.appendChild(c.cloneNode(true)));
    originals.forEach((c) => track.insertBefore(c.cloneNode(true), track.firstChild));
    let idx = n; // start on the first real card
    let animating = false;

    const cardStep = () => track.children[0].getBoundingClientRect().width +
      parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || 0);

    const go = (target, instant) => {
      track.style.transition = instant || reduce ? "none" : "transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)";
      track.style.transform = "translateX(" + (-target * cardStep()).toFixed(1) + "px)";
    };

    const step = (dir) => {
      if (animating) return;
      animating = true;
      idx += dir;
      go(idx, false);
      setTimeout(() => {
        if (idx >= n * 2) { idx -= n; go(idx, true); }
        if (idx < n) { idx += n; go(idx, true); }
        animating = false;
      }, reduce ? 30 : 520);
    };

    document.getElementById("proof-prev").addEventListener("click", () => step(-1));
    document.getElementById("proof-next").addEventListener("click", () => step(1));
    addEventListener("resize", () => go(idx, true), { passive: true });

    // auto-advance one card every 5s; readers can stop it by hovering or
    // tabbing in, and it idles while the tab is hidden. Off when motion is reduced.
    const carousel = document.querySelector(".proof__carousel");
    let timer = 0;
    const AUTO = 5000;
    const start = () => { if (!reduce && !timer && !document.hidden) timer = setInterval(() => step(1), AUTO); };
    const halt = () => { if (timer) { clearInterval(timer); timer = 0; } };
    viewport.addEventListener("mouseenter", halt);
    viewport.addEventListener("mouseleave", start);
    carousel.addEventListener("focusin", halt);
    carousel.addEventListener("focusout", (e) => { if (!carousel.contains(e.relatedTarget)) start(); });
    document.addEventListener("visibilitychange", () => { document.hidden ? halt() : start(); });

    go(idx, true);
    start();
  })();
</script>

<style>
  .proof {
    border-top: 1px solid var(--line);
    background: var(--bg);
  }
  .proof__head {
    max-width: 54rem;
  }
  .proof__title {
    margin-top: var(--space-xs);
    font-size: var(--step-3);
    max-width: 18ch;
  }
  .proof__lede {
    margin-top: var(--space-m);
  }

  .proof__carousel {
    margin-top: var(--space-xl);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(0.6rem, 2vw, 1.25rem);
  }
  .proof__viewport {
    overflow: hidden;
  }
  .proof__track {
    display: flex;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    will-change: transform;
  }
  .case {
    --case-pad: clamp(1.25rem, 3vw, 1.75rem);
    --cat-rgb: 216, 190, 134;
    --cat-color: var(--gold-text);
    flex: 0 0 calc((100% - 2 * clamp(1rem, 2.5vw, 1.5rem)) / 3);
    padding: var(--case-pad);
    background: var(--surface);
    border: 1px solid rgba(var(--cat-rgb), 0.32);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.3s var(--ease-out-quart), border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .case:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--cat-rgb), 0.6);
    box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    .case { transition: none; }
    .case:hover { transform: none; }
  }
  /* MOCK category palettes (layout test) */
  .case--harm { --cat-rgb: 216, 190, 134; --cat-color: var(--gold-text); }
  .case--hvac { --cat-rgb: 91, 157, 194; --cat-color: #8fc2dd; }
  .case--whole { --cat-rgb: 91, 194, 162; --cat-color: var(--mint); }

  .case__banner {
    margin: calc(-1 * var(--case-pad)) calc(-1 * var(--case-pad)) var(--space-m);
    padding: 0.55rem var(--case-pad);
    background: rgba(var(--cat-rgb), 0.14);
    border-bottom: 1px solid rgba(var(--cat-rgb), 0.32);
    color: var(--cat-color);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 980px) {
    .case {
      flex-basis: calc((100% - clamp(1rem, 2.5vw, 1.5rem)) / 2);
    }
  }
  @media (max-width: 640px) {
    .case {
      flex-basis: 100%;
    }
  }

  .case__type {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--cat-color);
    line-height: 1.3;
  }
  .case__place {
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    line-height: 1.3;
    min-height: 1.3em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .case__name {
    margin-top: var(--space-s);
    font-size: var(--step-1);
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.2;
    min-height: 2.4em; /* reserve two lines so figures line up */
  }
  .case__figure {
    margin-top: var(--space-m);
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 4.5vw, 3.2rem);
    line-height: 1;
    color: var(--cat-color);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .case__unit {
    margin-top: 0.35rem;
    font-size: var(--step--1);
    color: var(--body);
    line-height: 1.4;
    min-height: 2.8em; /* reserve two lines */
  }
  .case__scope {
    margin-top: var(--space-s);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    line-height: 1.5;
    min-height: 4.5em; /* reserve three lines */
  }
  .case__verifier {
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--mint);
    line-height: 1.4;
    min-height: 2.8em; /* reserve two lines */
  }
  .case__chip {
    margin-top: var(--space-s);
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.32em 0.8em;
  }

  .proof__arrow {
    appearance: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--gold-text);
    font-size: 1.1rem;
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.3s var(--ease-out-quart);
  }
  .proof__arrow:hover {
    border-color: var(--gold);
    background: rgba(194, 163, 104, 0.1);
    transform: translateY(-1px);
  }
  .proof__arrow:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
</style>
